---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import { Image } from 'astro:assets';
import plasticCrates from '../assets/images/plastic-crates.webp';
import plasticPallets from '../assets/images/plastic-pallets.webp';
import plasticWastebins from '../assets/images/plastic-wastebins.webp';
import handPalletTruck from '../assets/images/hand-pallet-truck.webp';
import warehouseInterior from '../assets/images/warehouse-interior.webp';
import { path } from '../lib/site';
import { CONTACT } from '../lib/contact';

const products = [
  { name: 'Plastic Crates', desc: 'Stackable & nestable crates for dairy, bakery, warehouse storage and material handling.', slug: '/products/plastic-crates', src: plasticCrates, alt: 'Plastic crates stacked in warehouse' },
  { name: 'Plastic Pallets', desc: 'Heavy-duty pallets for warehouse racking and logistics — single-face, double-face and nestable.', slug: '/products/plastic-pallets', src: plasticPallets, alt: 'Industrial plastic pallets stacked' },
  { name: 'Waste Bins', desc: 'Industrial dustbins and waste containers for municipal, commercial and factory use.', slug: '/products/waste-bins', src: plasticWastebins, alt: 'Industrial waste bins and dustbins' },
  { name: 'Hand Pallet Trucks', desc: 'Manual pallet jacks for warehouse loading and unloading — 2.5T and 3T capacities.', slug: '/products/hand-pallet-trucks', src: handPalletTruck, alt: 'Hand pallet truck in warehouse' }
];

const applications = [
  { name: 'Warehousing', desc: 'Storage, racking and internal material movement — crates, pallets and pallet trucks.', icon: 'warehouse' },
  { name: 'Manufacturing', desc: 'Work-in-process handling, parts storage and finished-goods staging.', icon: 'factory' },
  { name: 'Logistics', desc: 'Palletized freight, cross-docking and last-mile delivery equipment.', icon: 'truck' },
  { name: 'Municipal', desc: 'Dairy transport, cold-storage crates and commercial waste-collection bins.', icon: 'building' }
];

const reasons = [
  { label: 'HDPE / PP Construction', text: 'Molded from HDPE and PP copolymer for impact resistance, UV stability and long service life in demanding industrial environments.' },
  { label: 'Custom Sizing & Colour', text: 'Production to specific size and colour requirements for warehouse rack fit, branding or municipal contract specifications.' },
  { label: 'Complete Product Range', text: 'One source for crates, pallets, waste bins and hand pallet trucks — serving warehouses, dairy and municipal buyers.' },
  { label: 'Pan-India Dispatch', text: 'Direct enquiry to dispatch — pricing, spec sheets and timelines handled in a single call, with no distributor layers.' }
];
---

<Layout title="Vinayak Plastics — Material Handling & Packaging Products">
  <Header currentPage="/" />

  <main id="main">
  <Hero />

  <!-- TRUST BAR -->
  <section class="trustbar" aria-label="Company highlights">
    <div class="container">
      <div class="trustbar__grid">
        <div class="trustbar__item">
          <span class="trustbar__num">25+</span>
          <span class="trustbar__label">Years in Business</span>
        </div>
        <div class="trustbar__divider" aria-hidden="true"></div>
        <div class="trustbar__item">
          <span class="trustbar__num">500+</span>
          <span class="trustbar__label">Clients Served</span>
        </div>
        <div class="trustbar__divider" aria-hidden="true"></div>
        <div class="trustbar__item">
          <span class="trustbar__num">4</span>
          <span class="trustbar__label">Product Categories</span>
        </div>
        <div class="trustbar__divider" aria-hidden="true"></div>
        <div class="trustbar__item">
          <span class="trustbar__num">Pan-India</span>
          <span class="trustbar__label">Delivery Network</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-home" id="about" aria-label="About Vinayak Plastics">
    <div class="container">
      <div class="about-home__grid">
        <div class="about-home__media reveal">
          <Image
            src={warehouseInterior}
            alt="Spacious warehouse with organized storage and material handling"
            width={1125}
            height={750}
            widths={[480, 700]}
            sizes="(max-width: 900px) 100vw, 48vw"
            loading="lazy"
          />
        </div>
        <div class="about-home__body reveal">
          <p class="sec-index">About Us</p>
          <h2 class="about-home__title">Trusted manufacturer & supplier of <span class="text-orange">industrial plastic products</span></h2>
          <p class="about-home__text">Vinayak Plastics is a business house engaged in the manufacture and supply of all types of material handling and packaging products. From plastic crates and pallets to waste bins and hand pallet trucks — we serve warehouses, dairy distributors, municipal buyers and manufacturing facilities across India.</p>
          <p class="about-home__text">Our commitment to quality materials, competitive pricing and direct-to-buyer service has made us a trusted partner for businesses that depend on reliable equipment every day.</p>
          <a href={path('/about')} class="btn btn-ghost">Learn More About Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="products-home" id="products" aria-label="Our Products">
    <div class="container">
      <header class="products-home__head reveal">
        <p class="sec-index">What We Make</p>
        <h2 class="products-home__title">Industrial products built for <span class="text-orange">everyday operations.</span></h2>
        <p class="products-home__sub">HDPE and PP material handling and packaging equipment for warehouses, dairy distributors, and municipal buyers across India.</p>
      </header>

      <div class="products-home__grid">
        {products.map((p) => (
          <article class="ph-card reveal">
            <a href={path(p.slug)} class="ph-card__link">
              <div class="ph-card__img">
                <Image src={p.src} alt={p.alt} width={600} height={450} widths={[360, 520]} sizes="(max-width: 768px) 100vw, 25vw" loading="lazy" />
              </div>
              <div class="ph-card__body">
                <h3 class="ph-card__name">{p.name}</h3>
                <p class="ph-card__desc">{p.desc}</p>
                <span class="ph-card__cta">View Products <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLICATIONS -->
  <section class="apps-home" id="applications" aria-label="Applications">
    <div class="container">
      <header class="apps-home__head reveal">
        <p class="sec-index">Applications</p>
        <h2 class="apps-home__title">Where Vinayak products <span class="text-orange">do the work.</span></h2>
      </header>

      <div class="apps-home__grid">
        {applications.map((a) => (
          <article class="ap-card reveal">
            <div class="ap-card__icon" aria-hidden="true">
              {a.icon === 'warehouse' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V8l9-5 9 5v13"/><path d="M9 21V12h6v9"/><path d="M3 21h18"/></svg>
              )}
              {a.icon === 'factory' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V8l5 4V8l5 4V4h3v16"/></svg>
              )}
              {a.icon === 'truck' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              )}
              {a.icon === 'building' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22V12h6v10"/><path d="M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01"/></svg>
              )}
            </div>
            <h3 class="ap-card__name">{a.name}</h3>
            <p class="ap-card__desc">{a.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="why-home" id="why-us" aria-label="Why choose Vinayak Plastics">
    <div class="container">
      <div class="why-home__grid">
        <div class="why-home__intro reveal">
          <p class="sec-index">Why Vinayak?</p>
          <h2 class="why-home__title">Reliable plastic solutions for demanding <span class="text-orange">industrial environments.</span></h2>
          <p class="why-home__sub">A business house engaged in the supply of all types of material handling and packaging products — direct enquiry, no layers.</p>
          <a href={path('/contact')} class="btn btn-primary">Get a Quote</a>
        </div>

        <div class="why-home__features">
          {reasons.map((r) => (
            <article class="wf-card reveal">
              <div class="wf-card__check" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              </div>
              <div>
                <h3 class="wf-card__label">{r.label}</h3>
                <p class="wf-card__text">{r.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner" aria-label="Get a quote">
    <div class="container reveal">
      <h2 class="display-700">Need the right product<br>for your <span class="text-orange">operation?</span></h2>
      <p>Let's discuss your requirement — product, quantity, dimensions and dispatch timeline. Call or WhatsApp us directly.</p>
      <div class="cta-buttons">
        <a href={path('/contact')} class="btn btn-primary">Get a Quote</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
        <a href={CONTACT.phoneHref} class="btn btn-ghost-light">Call {CONTACT.phoneDisplay}</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>
