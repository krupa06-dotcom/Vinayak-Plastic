---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import { Image } from 'astro:assets';
import plasticCrates from '../assets/images/plastic-crates.webp';
import plasticPallets from '../assets/images/plastic-pallets.webp';
import plasticWastebins from '../assets/images/plastic-wastebins.webp';
import handPalletTruck from '../assets/images/hand-pallet-truck.webp';
import warehouseInterior from '../assets/images/warehouse-interior.webp';
import { path } from '../lib/site';

// Editorial product panels — large imagery + catalogue-style numbering.
const panels = [
  {
    num: '01',
    name: 'Plastic Crates',
    desc: 'Stackable & nestable crates for dairy, bakery, warehouse storage and material handling.',
    slug: '/products/plastic-crates',
    src: plasticCrates,
    alt: 'Plastic crates stacked in warehouse',
    w: 600,
    h: 500
  },
  {
    num: '02',
    name: 'Plastic Pallets',
    desc: 'Heavy-duty pallets for warehouse racking and logistics — single-face, double-face and nestable.',
    slug: '/products/plastic-pallets',
    src: plasticPallets,
    alt: 'Industrial plastic pallets stacked',
    w: 600,
    h: 400
  },
  {
    num: '03',
    name: 'Waste Bins',
    desc: 'Industrial dustbins and waste containers for municipal, commercial and factory use.',
    slug: '/products/waste-bins',
    src: plasticWastebins,
    alt: 'Industrial waste bins and dustbins',
    w: 604,
    h: 508
  },
  {
    num: '04',
    name: 'Hand Pallet Trucks',
    desc: 'Manual pallet jacks for warehouse loading and unloading — 2.5T and 3T capacities.',
    slug: '/products/hand-pallet-trucks',
    src: handPalletTruck,
    alt: 'Hand pallet truck in warehouse operation',
    w: 1200,
    h: 800
  }
];

// Application areas — all drawn from existing product-page content.
const applications = [
  { num: '01', name: 'Warehousing', desc: 'Storage, racking and internal material movement — crates, pallets and pallet trucks for warehouse operations.' },
  { num: '02', name: 'Manufacturing', desc: 'Work-in-process handling, parts storage and finished-goods staging within production facilities.' },
  { num: '03', name: 'Logistics & Distribution', desc: 'Palletized freight, cross-docking and last-mile delivery with durable, reusable equipment.' },
  { num: '04', name: 'Dairy & Municipal', desc: 'Dairy transport and cold-storage crates, plus municipal and commercial waste-collection bins.' }
];

// Why Vinayak — numbered pillars built from existing site claims.
const reasons = [
  { num: '01', label: 'HDPE / PP', text: 'Crates, bins and pallets molded from HDPE / PP copolymer for impact resistance, UV stability and long service life in demanding environments.' },
  { num: '02', label: 'Custom Sizing', text: 'Production to specific size and color requirements for warehouse rack fit, branding or municipal contract specifications.' },
  { num: '03', label: 'Industrial Applications', text: 'One source for crates, pallets, waste bins and hand pallet trucks — serving warehouses, dairy and municipal buyers.' },
  { num: '04', label: 'Pan-India Dispatch', text: 'Direct enquiry to dispatch — pricing, spec sheets and timelines handled in a single call, with no distributor layers.' }
];
---

<Layout title="Vinayak Plastics — Material Handling & Packaging Products">
  <Header currentPage="/" />

  <main id="main">
  <Hero />

  <!-- ===== PRODUCTS ===== -->
  <section class="section section-warm prod-editorial" id="products" aria-label="Our Products">
    <div class="container">
      <header class="sec-head reveal">
        <p class="sec-index">01 / What We Make</p>
        <h2 class="sec-title">Industrial products built for <span class="text-orange">everyday operations.</span></h2>
        <p class="sec-sub">HDPE and PP material handling and packaging equipment for warehouses, dairy distributors, and municipal buyers across India.</p>
      </header>

      <div class="prod-panels">
        {panels.map((p, i) => (
          <article class={`prod-panel reveal${i % 2 === 1 ? ' prod-panel--flip' : ''}`}>
            <div class="prod-panel-media">
              <Image
                src={p.src}
                alt={p.alt}
                width={p.w}
                height={p.h}
                widths={[480, 720]}
                sizes="(max-width: 900px) 100vw, 52vw"
                loading="lazy"
              />
            </div>
            <div class="prod-panel-body">
              <span class="prod-panel-num">{p.num}</span>
              <div class="prod-panel-info">
                <h3 class="prod-panel-name">{p.name}</h3>
                <p class="prod-panel-desc">{p.desc}</p>
              </div>
              <a class="prod-panel-link" href={path(p.slug)}>View Products <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== APPLICATIONS ===== -->
  <section class="section apps-vp" id="applications" aria-label="Applications">
    <div class="container">
      <header class="sec-head reveal">
        <p class="sec-index">02 / Applications</p>
        <h2 class="sec-title">Where Vinayak products do the work.</h2>
        <p class="sec-sub">Material handling equipment in service across production, storage, distribution and waste collection.</p>
      </header>

      <div class="apps-grid">
        {applications.map((a) => (
          <article class="app-block reveal">
            <span class="app-num" aria-hidden="true">{a.num}</span>
            <h3 class="app-name">{a.name}</h3>
            <p class="app-desc">{a.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== WHY VINAYAK ===== -->
  <section class="section section-warm why-vp" id="why-us" aria-label="Why Vinayak Plastics">
    <div class="container">
      <div class="why-grid">
        <div class="why-intro reveal">
          <header class="sec-head sec-head--tight">
            <p class="sec-index">03 / Why Vinayak?</p>
            <h2 class="sec-title">Reliable plastic solutions for demanding <span class="text-orange">industrial environments.</span></h2>
            <p class="sec-sub">A business house engaged in the supply of all types of material handling and packaging products — direct enquiry, no layers.</p>
          </header>
          <figure class="why-media">
            <Image
              src={warehouseInterior}
              alt="Spacious warehouse with organized storage and material handling"
              width={1125}
              height={750}
              widths={[480, 700]}
              sizes="(max-width: 900px) 100vw, 44vw"
              loading="lazy"
            />
          </figure>
        </div>

        <ol class="why-list">
          {reasons.map((r) => (
            <li class="why-item reveal">
              <span class="why-num">{r.num}</span>
              <div>
                <h3 class="why-label">{r.label}</h3>
                <p class="why-text">{r.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-premium" aria-label="Get a quote">
    <div class="container reveal">
      <p class="sec-index sec-index--light">Get a Quote</p>
      <h2 class="cta-title">Need the right product<br>for your <span class="text-orange">operation?</span></h2>
      <p class="cta-sub">Let's discuss your requirement — product, quantity, dimensions and dispatch timeline. Call or WhatsApp us directly.</p>
      <div class="cta-buttons">
        <a href={path('/contact')} class="btn btn-primary">Get a Quote</a>
        <a href="https://wa.me/91XXXXXXXXXX" class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
        <a href="tel:+91XXXXXXXXXX" class="btn btn-ghost-light">Call +91 XXXXX-XXXXX</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>