---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import warehouseInterior from '../assets/images/warehouse-interior.webp';
import plasticCrates from '../assets/images/plastic-crates.webp';
import plasticPallets from '../assets/images/plastic-pallets.webp';
import plasticWastebins from '../assets/images/plastic-wastebins.webp';
import handPalletTruck from '../assets/images/hand-pallet-truck.webp';
import { path } from '../lib/site';
import { CONTACT } from '../lib/contact';

const stats = [
  { num: '25+', label: 'Years in Business' },
  { num: '500+', label: 'Clients Served' },
  { num: '6+', label: 'Product Categories' },
  { num: 'Pan-India', label: 'Dispatch Network' }
];

const values = [
  {
    label: 'Quality Materials',
    text: 'Products molded from HDPE and PP grades — impact resistant, UV stabilized, and built for long service life in demanding industrial environments.'
  },
  {
    label: 'Direct & Transparent',
    text: 'No distributor layers, no automated systems. Every enquiry is handled by a person who knows the product, specification, and dispatch timelines.'
  },
  {
    label: 'Custom Capability',
    text: 'We work with buyers to deliver specific sizes, colors, and load-bearing requirements to match warehouse racking and contract specifications.'
  },
  {
    label: 'Pan-India Reach',
    text: 'From a single enquiry to dispatch — pricing, spec sheets, and timelines coordinated in one call, serving buyers across the country.'
  }
];

const products = [
  { img: plasticCrates, alt: 'Plastic crates stacked in warehouse', name: 'Plastic Crates' },
  { img: plasticPallets, alt: 'Industrial plastic pallets stacked', name: 'Plastic Pallets' },
  { img: plasticWastebins, alt: 'Industrial waste bins and dustbins', name: 'Waste Bins / Dustbins' },
  { img: handPalletTruck, alt: 'Hand pallet truck in warehouse', name: 'Hand Pallet Trucks' }
];

const process = [
  { step: '01', title: 'Enquire', text: 'Call or WhatsApp with your product, quantity, and specification requirements.' },
  { step: '02', title: 'Quote', text: 'Receive pricing, dimension sheets, and dispatch timelines directly from our team.' },
  { step: '03', title: 'Supply', text: 'We coordinate manufacture or sourcing and dispatch to your location across India.' },
  { step: '04', title: 'Support', text: 'Ongoing support for repeat orders, service, and custom product development.' }
];
---

<Layout 
  title="About Vinayak Plastics | Material Handling & Packaging"
  description="About Vinayak Plastics — business house supplying material handling & packaging products — plastic crates, pallets, waste bins and hand pallet trucks — to warehouses, dairy and municipal buyers across India."
>
  <Header currentPage="/about" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="about-hero">
    <div class="container">
      <p class="breadcrumb"><a href={path('/')}>Home</a> / About Us</p>
      <h1 class="about-hero__title">Industrial materials, handled <span class="text-orange">right.</span></h1>
      <p class="about-hero__sub">Vinayak Plastics supplies material handling and packaging products that keep warehouses, dairy plants, and municipalities running — durable, dependable, and backed by direct service.</p>
      <div class="about-hero__actions">
        <a href={path('/products')} class="btn btn-primary">Explore Our Products</a>
        <a href={path('/contact')} class="btn btn-outline-light">Get a Quote</a>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section class="about-who">
    <div class="container">
      <div class="about-who__grid">
        <div class="about-who__media reveal">
          <Image
            src={warehouseInterior}
            alt="Spacious warehouse with organized storage and material handling equipment"
            width={1125}
            height={750}
            widths={[480, 700]}
            sizes="(max-width: 1024px) 100vw, 48vw"
            loading="lazy"
          />
        </div>
        <div class="about-who__body reveal">
          <p class="sec-index">Who We Are</p>
          <h2 class="about-who__title">A business house built on <span class="text-orange">reliable supply</span></h2>
          <p class="about-who__text">Vinayak Plastics is a business house engaged in the supply of all types of material handling and packaging products. We specialize in plastic crates, pallets, waste bins, hand pallet trucks, ice boxes, storage bins, and racking systems serving warehouses, dairy distributors, municipal corporations, and commercial buyers across India.</p>
          <p class="about-who__text">Everything we supply is manufactured using HDPE and PP grades — materials chosen for impact resistance, UV stability, and long service life in demanding industrial environments. We work with buyers to deliver products that meet specific size, color, and load-bearing requirements.</p>
          <a href={path('/products')} class="btn btn-ghost">See Our Full Product Range</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section class="about-stats-band">
    <div class="container">
      <div class="about-stats-grid">
        {stats.map((s) => (
          <div class="about-stat reveal">
            <div class="about-stat__num">{s.num}</div>
            <div class="about-stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== VALUES ===== -->
  <section class="about-values">
    <div class="container-sm">
      <div class="section-header reveal">
        <p class="sec-index">What We Stand For</p>
        <h2 class="display-700">The Vinayak difference</h2>
        <p>Four principles guide how we work — from the first enquiry to every repeat order.</p>
      </div>
      <div class="about-values__grid">
        {values.map((v) => (
          <article class="about-value reveal">
            <div class="about-value__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h3 class="about-value__label">{v.label}</h3>
            <p class="about-value__text">{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PRODUCT RANGE ===== -->
  <section class="about-range">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Our Range</p>
        <h2 class="display-700">Everything for material handling, <span class="text-orange">under one roof</span></h2>
        <p>From plastic crates for dairy and bakery storage to industrial pallets for warehouse racking — we cover the full spectrum of material handling needs.</p>
      </div>
      <div class="about-range__grid">
        {products.map((p, i) => (
          <a href={path(`/products/${['plastic-crates','plastic-pallets','waste-bins','hand-pallet-trucks'][i]}`)} class="about-range__card reveal">
            <div class="about-range__img">
              <Image src={p.img} alt={p.alt} width={600} height={450} widths={[360, 520]} sizes="(max-width: 768px) 100vw, 25vw" loading="lazy" />
            </div>
            <div class="about-range__body">
              <h3>{p.name}</h3>
              <span>View Range <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="about-process">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">How We Work</p>
        <h2 class="display-700">A simple, direct process</h2>
        <p>From enquiry to dispatch — no layers, no delays, no automated runaround.</p>
      </div>
      <div class="about-process__grid">
        {process.map((p, i) => (
          <div class="about-step reveal">
            <div class="about-step__num">{p.step}</div>
            <h3 class="about-step__title">{p.title}</h3>
            <p class="about-step__text">{p.text}</p>
            {i < process.length - 1 && <div class="about-step__arrow" aria-hidden="true">→</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label="Get in touch">
    <div class="container reveal">
      <h2 class="display-700">Discuss Your Requirements</h2>
      <p>Call or WhatsApp us for pricing, product specifications, and dispatch timelines.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>
