---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path } from '../lib/site';
---

<Layout 
  title="Contact Vinayak Plastics | Quote for Crates, Pallets & Waste Bins"
  description="Contact Vinayak Plastics by phone or WhatsApp for pricing, product specs and dispatch timelines on plastic crates, pallets, waste bins and hand pallet trucks."
>
  <Header currentPage="/contact" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href={path('/')}>Home</a> / Contact Us</p>
      <h1 class="display-800">Get in Touch</h1>
      <p>Call, WhatsApp, or email us directly for pricing, product specifications, and dispatch information.</p>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-info-card reveal">
          <h2>Contact Information</h2>

          <div class="contact-item">
            <div class="ci-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </div>
            <div>
              <h3>Phone</h3>
              <p>+91 XXXXX-XXXXX</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="ci-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </div>
            <div>
              <h3>WhatsApp</h3>
              <a href="https://wa.me/91XXXXXXXXXX" target="_blank" rel="noopener">+91 XXXXX-XXXXX</a>
            </div>
          </div>

          <div class="contact-item">
            <div class="ci-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <h3>Email</h3>
              <a href="mailto:info@vinayakplastics.in">info@vinayakplastics.in</a>
            </div>
          </div>

          <div class="contact-item">
            <div class="ci-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <h3>Address</h3>
              <p>[City, State, India]</p>
            </div>
          </div>

          <div style="margin-top:20px;padding:12px 16px;background:rgba(232,99,12,0.08);border-radius:6px;border-left:3px solid var(--orange)">
            <p style="font-size:0.82rem;color:var(--steel)"><strong style="color:#A33A07;font-family:var(--font-mono)">NOTE:</strong> Contact details shown are placeholders. Replace with actual information before publishing.</p>
          </div>
        </div>

        <div class="contact-form-card reveal">
          <h2>Send a Message</h2>
          <p style="color:var(--steel);font-size:0.9rem;margin-bottom:20px">Fill in the form below and we'll get back to you with product information and pricing.</p>
          <form action="#" method="post">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Your Name</label>
                <input type="text" id="name" name="name" placeholder="Your full name" required>
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="Your phone number" required>
              </div>
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="Your email address" required>
            </div>
            <div class="form-group">
              <label for="product">Product Interest</label>
              <input type="text" id="product" name="product" placeholder="e.g. Plastic Crates, Pallets, Dustbins...">
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="Tell us about your requirements — quantity, dimensions, delivery location..." required></textarea>
            </div>
            <p style="font-size:0.78rem;color:var(--steel);margin-bottom:16px">This is a demo form. Use phone/WhatsApp for actual enquiries.</p>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send Enquiry</button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label="Call to action">
    <div class="container reveal">
      <h2 class="display-700">Prefer to Talk Directly?</h2>
      <p>We're available on phone and WhatsApp for quick responses on pricing and product availability.</p>
      <div class="cta-buttons">
        <a href="tel:+91XXXXXXXXXX" class="btn btn-primary">Call +91 XXXXX-XXXXX</a>
        <a href="https://wa.me/91XXXXXXXXXX" class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>