---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import plasticCrates from '../../assets/images/plastic-crates.webp';
import plasticPallets from '../../assets/images/plastic-pallets.webp';
import plasticWastebins from '../../assets/images/plastic-wastebins.webp';
import handPalletTruck from '../../assets/images/hand-pallet-truck.webp';
import { path } from '../../lib/site';
import { CONTACT } from '../../lib/contact';
import { getCategoriesWithSubCategories } from '../../lib/db';
import { hasSupabase } from '../../lib/supabase';

// Fallback product data (used when Supabase is not configured)
const fallbackProducts = [
  { title: 'Plastic Crates', slug: 'plastic-crates', img: plasticCrates, alt: 'Plastic crates stacked in warehouse', desc: 'Stackable & nestable crates for dairy, bakery, warehouse and material handling.', keywords: 'crates dairy bakery warehouse storage HDPE PP stackable nestable' },
  { title: 'Plastic Pallets', slug: 'plastic-pallets', img: plasticPallets, alt: 'Industrial pallets stacked', desc: 'Heavy-duty pallets for warehouse racking, logistics, and export — single & double-face.', keywords: 'pallets racking logistics export HDPE forklift shipping' },
  { title: 'Waste Bins / Dustbins', slug: 'waste-bins', img: plasticWastebins, alt: 'Industrial waste bins', desc: 'Industrial dustbins for municipal, commercial, and factory use — wheeled & lidded options.', keywords: 'waste bins dustbins municipal commercial factory wheeled lidded segregation recycling' },
  { title: 'Hand Pallet Trucks', slug: 'hand-pallet-trucks', img: handPalletTruck, alt: 'Hand pallet truck in warehouse', desc: 'Manual pallet jacks for loading/unloading — 2.5T and 3T capacities with nylon/PU wheels.', keywords: 'pallet truck jack manual 2.5T 3T nylon PU wheels hydraulic loading' }
];

// Try to fetch categories from Supabase
let categories: Array<{ name: string; slug: string; description: string | null; image_url: string | null }> = [];

try {
  if (hasSupabase()) {
    const dbCategories = await getCategoriesWithSubCategories();
    if (dbCategories.length > 0) {
      categories = dbCategories.map(cat => ({
        name: cat.name,
        slug: cat.slug,
        description: cat.description,
        image_url: cat.image_url
      }));
    }
  }
} catch (error) {
  console.warn('Supabase not configured, using fallback data');
}

// Use fallback products if no categories from database
const allProducts = categories.length > 0 
  ? categories.map(cat => ({
      title: cat.name,
      slug: cat.slug,
      img: cat.image_url || plasticCrates, // Default image
      alt: cat.description || cat.name,
      desc: cat.description || '',
      keywords: cat.name.toLowerCase()
    }))
  : fallbackProducts;
---

<Layout 
  title="Products | Vinayak Plastics — Plastic Crates, Pallets & Waste Bins"
  description="Explore Vinayak Plastics product range — plastic crates, plastic pallets, waste bins / dustbins and hand pallet trucks. HDPE & PP industrial-grade material handling equipment."
>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href={path('/')}>Home</a> / Products</p>
      <h1 class="display-800">Our Product Range</h1>
      <p>Industrial-grade material handling and packaging equipment for warehouses, dairy, municipal, and commercial buyers.</p>
    </div>
  </section>

  <!-- ===== SEARCH RESULTS ===== -->
  <section class="section search-results" id="search-results" style="display:none">
    <div class="container">
      <div class="section-header">
        <h2 class="display-700">Search Results</h2>
        <p id="search-query-text"></p>
      </div>
      <div class="cat-grid" id="search-grid"></div>
      <div id="no-results" style="display:none;text-align:center;padding:3rem 0">
        <p style="font-size:1.1rem;color:var(--steel)">No products found matching your search.</p>
        <a href={path('/products')} class="btn btn-primary" style="margin-top:1rem">View All Products</a>
      </div>
    </div>
  </section>

  <!-- ===== CATEGORIES ===== -->
  <section class="section" id="categories-section">
    <div class="container">
      <div class="cat-grid">

        <a href={path('/products/plastic-crates')} class="cat-card reveal">
          <Image
            src={plasticCrates}
            alt="Plastic crates stacked in warehouse"
            width={600}
            height={500}
            widths={[400, 600]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="cat-overlay"></div>
          <div class="cat-content">
            <h2>Plastic Crates</h2>
            <p>Stackable &amp; nestable crates for dairy, bakery, warehouse and material handling</p>
            <div class="cat-arrow" aria-hidden="true">→</div>
          </div>
        </a>

        <a href={path('/products/plastic-pallets')} class="cat-card reveal">
          <Image
            src={plasticPallets}
            alt="Industrial pallets stacked"
            width={600}
            height={400}
            widths={[400, 600]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="cat-overlay"></div>
          <div class="cat-content">
            <h2>Plastic Pallets</h2>
            <p>Heavy-duty pallets for warehouse racking, logistics, and export — single &amp; double-face</p>
            <div class="cat-arrow" aria-hidden="true">→</div>
          </div>
        </a>

        <a href={path('/products/waste-bins')} class="cat-card reveal">
          <Image
            src={plasticWastebins}
            alt="Industrial waste bins"
            width={604}
            height={508}
            widths={[400, 604]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="cat-overlay"></div>
          <div class="cat-content">
            <h2>Waste Bins / Dustbins</h2>
            <p>Industrial dustbins for municipal, commercial, and factory use — wheeled &amp; lidded options</p>
            <div class="cat-arrow" aria-hidden="true">→</div>
          </div>
        </a>

        <a href={path('/products/hand-pallet-trucks')} class="cat-card reveal">
          <Image
            src={handPalletTruck}
            alt="Hand pallet truck in warehouse"
            width={1536}
            height={1024}
            widths={[400, 768, 1536]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="cat-overlay"></div>
          <div class="cat-content">
            <h2>Hand Pallet Trucks</h2>
            <p>Manual pallet jacks for loading/unloading — 2.5T and 3T capacities with nylon/PU wheels</p>
            <div class="cat-arrow" aria-hidden="true">→</div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ===== ADDITIONAL PRODUCTS ===== -->
  <section class="section-warm">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="display-700">Also Available</h2>
        <p>Beyond our core range, we supply additional products for specialized material handling needs.</p>
      </div>
      <div class="product-grid reveal">
        <article class="product-card">
          <div class="product-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="6" width="32" height="36" rx="3" stroke="currentColor" stroke-width="2" fill="none"/>
              <path d="M8 18h32M16 6v36M32 6v36" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
            </svg>
          </div>
          <h3>Ice Boxes</h3>
          <p>Insulated plastic ice boxes for food transport, fishing, and catering. Available in multiple capacities with durable latch closures.</p>
        </article>
        
        <article class="product-card">
          <div class="product-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="40" height="32" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
              <rect x="10" y="14" width="28" height="6" rx="1" stroke="currentColor" stroke-width="1.5" opacity="0.5" fill="none"/>
              <rect x="10" y="24" width="28" height="6" rx="1" stroke="currentColor" stroke-width="1.5" opacity="0.5" fill="none"/>
              <rect x="10" y="34" width="28" height="2" rx="1" stroke="currentColor" stroke-width="1.5" opacity="0.4" fill="none"/>
            </svg>
          </div>
          <h3>Storage Bins</h3>
          <p>Plastic storage bins for warehouse organization, inventory management, and parts handling. Available in multiple sizes with color options.</p>
        </article>
        
        <article class="product-card">
          <div class="product-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="10" width="36" height="28" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
              <path d="M6 20h36" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
              <rect x="16" y="10" width="16" height="28" stroke="currentColor" stroke-width="1.5" opacity="0.3" fill="none"/>
            </svg>
          </div>
          <h3>Racking Systems</h3>
          <p>Industrial racking solutions for warehouse storage optimization. Boltless assembly, adjustable shelf heights, and heavy-duty load capacity.</p>
        </article>
        
        <article class="product-card">
          <div class="product-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2" fill="none"/>
              <path d="M24 12v12l8 4" stroke="currentColor" stroke-width="2" opacity="0.5"/>
            </svg>
          </div>
          <h3>Custom Molding</h3>
          <p>We work with buyers to develop custom plastic products for specific industrial, municipal, or commercial applications.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label="Get a quote">
    <div class="container reveal">
      <h2 class="display-700">Need Product Specs or Pricing?</h2>
      <p>Call or WhatsApp us directly for detailed dimensions, material grades, and dispatch timelines.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ productsJson: JSON.stringify(allProducts) }}>
(function () {
  var params = new URLSearchParams(window.location.search);
  var q = (params.get('q') || '').trim().toLowerCase();
  if (!q) return;

  var products = JSON.parse(productsJson);
  var matches = products.filter(function (p) {
    return (p.title + ' ' + p.desc + ' ' + p.keywords).toLowerCase().indexOf(q) !== -1;
  });

  var searchResults = document.getElementById('search-results');
  var searchGrid = document.getElementById('search-grid');
  var noResults = document.getElementById('no-results');
  var queryText = document.getElementById('search-query-text');
  var categoriesSection = document.getElementById('categories-section');

  if (!searchResults || !searchGrid) return;

  queryText.textContent = 'Showing results for "' + params.get('q') + '"';

  if (matches.length > 0) {
    matches.forEach(function (p) {
      var card = document.createElement('a');
      card.href = '/Vinayak-Plastic/products/' + p.slug;
      card.className = 'cat-card';
      card.innerHTML =
        '<img src="' + p.img.src + '" alt="' + p.alt + '" width="600" height="500" loading="lazy" />' +
        '<div class="cat-overlay"></div>' +
        '<div class="cat-content">' +
          '<h2>' + p.title + '</h2>' +
          '<p>' + p.desc + '</p>' +
          '<div class="cat-arrow" aria-hidden="true">→</div>' +
        '</div>';
      searchGrid.appendChild(card);
    });
  } else {
    noResults.style.display = 'block';
  }

  searchResults.style.display = 'block';
  categoriesSection.querySelector('.section-header').innerHTML =
    '<h2 class="display-700">All Products</h2><p>Browse our complete range of industrial material handling equipment.</p>';
})();
</script>