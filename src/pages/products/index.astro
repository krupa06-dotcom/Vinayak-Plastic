---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { path } from '../../lib/site';
import { CONTACT } from '../../lib/contact';
import { getCatalogueData, resolveImageUrl } from '../../lib/db';

const catalogue = await getCatalogueData();
const { categories, subCategories } = catalogue;

function sizeLabel(count: number): string {
  return count > 0
    ? `${count} ${count === 1 ? 'Size / Model' : 'Sizes / Models'}`
    : 'Range on request';
}

// Build card data
const categoryCards = categories.map(cat => ({
  name: cat.name,
  slug: cat.slug,
  description: cat.description,
  image: resolveImageUrl(cat.image_url),
  count: sizeLabel(cat.variants_count),
  href: path(`/categories/${cat.slug}`)
}));

const subCategoryCards = subCategories.map(sub => ({
  name: sub.name,
  slug: sub.slug,
  categoryName: sub.category_name,
  categorySlug: sub.category_slug,
  description: sub.description,
  image: resolveImageUrl(sub.image_url),
  count: sizeLabel(sub.variants_count),
  href: path(`/categories/${sub.category_slug}/${sub.slug}`)
}));
---

<Layout
  title="Products | Vinayak Plastics — Plastic Crates, Pallets & Waste Bins"
  description="Explore Vinayak Plastics product range — plastic crates, plastic pallets, waste bins / dustbins and hand pallet trucks. HDPE & PP industrial-grade material handling equipment."
>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href={path('/')}>Home</a> / Products</p>
      <h1 class="display-800">Our Product Range</h1>
      <p>Industrial-grade material handling and packaging equipment for warehouses, dairy, municipal, and commercial buyers.</p>
    </div>
  </section>

  <!-- ===== SEARCH RESULTS (shown by JS when ?q=) ===== -->
  <section class="section search-results" id="search-results" style="display:none">
    <div class="container">
      <div class="section-header">
        <h2 class="display-700">Search Results</h2>
        <p id="search-query-text"></p>
      </div>
      <div class="res-grid" id="search-grid"></div>
      <div id="no-results" class="empty-state" style="display:none">
        <h3>No results found</h3>
        <p>No categories or product types match your search. <a href={path('/products')}>View all products</a></p>
      </div>
    </div>
  </section>

  <!-- ===== SECTION 1: MAIN CATEGORIES ===== -->
  <section class="section" id="categories-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="sec-index">01 · Main Categories</span>
        <h2 class="display-700">Explore Our Product Range</h2>
        <p>Industrial-grade material handling and packaging equipment, organised by primary product family.</p>
      </div>

      {categoryCards.length > 0 ? (
        <div class="mc-grid">
          {categoryCards.map(card => (
            <a href={card.href} class="mc-card reveal" data-cat={card.slug}>
              <div class="mc-card__img">
                {card.image ? (
                  <img
                    src={card.image}
                    alt={`${card.name} — Vinayak Plastics product range`}
                    width="600"
                    height="450"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="mc-card__placeholder">{card.name}</span>
                )}
              </div>
              <div class="mc-card__body">
                <h3>{card.name}</h3>
                {card.description && <p>{card.description}</p>}
                <div class="mc-card__meta">
                  <span class="mc-card__count">{card.count}</span>
                  <span class="mc-card__cta">Explore Range <span aria-hidden="true">→</span></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state reveal">
          <h3>Product catalogue coming soon</h3>
          <p>We are currently updating our product listings. Please check back shortly or <a href={path('/contact')}>contact us</a> directly for product information.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== SECTION 2: SUB CATEGORIES ===== -->
  <section class="section section-warm" id="subcategory-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="sec-index">02 · Product Types</span>
        <h2 class="display-700">Browse by Product Type</h2>
        <p>Specific product types within each family — choose a type to see exact dimensions, specifications and availability.</p>
      </div>

      {subCategoryCards.length > 0 ? (
        <div class="sc-carousel reveal" id="sc-carousel" role="region" aria-roledescription="carousel" aria-label="Product types">
          <div class="sc-carousel__viewport" tabindex="0" aria-label="Scroll through product types">
            <div class="sc-track">
              {subCategoryCards.map(card => (
                <a
                  href={card.href}
                  class="sc-card"
                  data-sub={card.slug}
                  data-cat={card.categorySlug}
                  data-search={`${card.name} ${card.categoryName} ${card.description || ''}`.toLowerCase()}
                >
                  <div class="sc-card__img">
                    {card.image ? (
                      <img
                        src={card.image}
                        alt={`${card.name} — ${card.categoryName}`}
                        width="480"
                        height="300"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="sc-card__placeholder">{card.name}</span>
                    )}
                  </div>
                  <div class="sc-card__body">
                    <span class="sc-card__parent">{card.categoryName}</span>
                    <h3>{card.name}</h3>
                    <div class="sc-card__meta">
                      <span class="sc-card__count">{card.count}</span>
                      <span class="sc-card__cta">View <span aria-hidden="true">→</span></span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="empty-state reveal">
          <h3>Product types coming soon</h3>
          <p>We are adding detailed product breakdowns. Please check back or <a href={path('/contact')}>contact us</a> for the full range.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label="Get a quote">
    <div class="container reveal">
      <h2 class="display-700">Need Product Specs or Pricing?</h2>
      <p>Call or WhatsApp us directly for detailed dimensions, material grades, and dispatch timelines.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ==========================================================
     Products page — section-specific overrides
     ========================================================== */

  /* SECTION 01 · Main categories: wide feature cards, 2-up */
  #categories-section .mc-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  #categories-section .mc-card {
    border-top: 3px solid var(--orange);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px rgba(18, 42, 78, 0.04);
  }

  #categories-section .mc-card:hover,
  #categories-section .mc-card:focus-visible {
    box-shadow: 0 18px 44px rgba(232, 99, 12, 0.14);
    border-color: rgba(232, 99, 12, 0.35);
  }

  #categories-section .mc-card__img {
    aspect-ratio: 16/10;
  }

  #categories-section .mc-card__body {
    padding: 28px 28px 24px;
  }

  #categories-section .mc-card__body h3 {
    font-size: 1.7rem;
  }

  #categories-section .mc-card__count {
    color: var(--orange-deep);
    background: rgba(232, 99, 12, 0.1);
  }

  #categories-section .mc-card__cta {
    color: var(--orange-deep);
  }

  /* ==========================================================
     SECTION 02 · Sub categories — native horizontal scroll strip
     Manual sliding via touch / trackpad / mouse drag / arrows —
     no arrows, progress bar or transform engine needed.
     ========================================================== */

  /* Host */
  #subcategory-section .sc-carousel {
    position: relative;
    outline-offset: 4px;
    -webkit-overflow-scrolling: touch;
  }

  /* Viewport — the strip itself scrolls horizontally. Snap makes
     every swipe / drag settle on a card boundary. */
  #subcategory-section .sc-carousel__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    touch-action: pan-y;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
  }

  #subcategory-section .sc-carousel__viewport:active {
    cursor: grabbing;
  }

  #subcategory-section .sc-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  #subcategory-section .sc-track {
    display: flex;
    align-items: stretch;
    gap: 20px;
  }

  #subcategory-section .sc-track > .sc-card {
    flex: 0 0 auto;
    width: calc((100% - 60px) / 4);
    scroll-snap-align: start;
  }

  /* ---- Compact gallery card ---- */
  #subcategory-section .sc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(18, 42, 78, 0.08);
    border-top: 3px solid var(--orange);
    background: var(--white);
    box-shadow: 0 1px 2px rgba(18, 42, 78, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #subcategory-section .sc-card:hover,
  #subcategory-section .sc-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(18, 42, 78, 0.12);
  }

  /* Fixed image area — consistent across cards & breakpoints */
  #subcategory-section .sc-card__img {
    position: relative;
    flex: 0 0 150px;
    height: 150px;
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--warm-off-white);
    border-bottom: 1px solid rgba(18, 42, 78, 0.06);
  }

  #subcategory-section .sc-card__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  #subcategory-section .sc-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    text-transform: uppercase;
    color: rgba(18, 42, 78, 0.3);
    background: var(--warm-off-white);
  }

  /* Body — flex column so the meta row is pinned to the bottom */
  #subcategory-section .sc-card__body {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 16px 16px 14px;
  }

  #subcategory-section .sc-card__parent {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange-deep);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 6px;
    padding-bottom: 6px;
    position: relative;
  }

  #subcategory-section .sc-card__parent::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 20px;
    height: 2px;
    background: var(--orange);
  }

  #subcategory-section .sc-card__body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--deep-navy);
    min-height: 2.4em;
    margin-bottom: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #subcategory-section .sc-card__meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid rgba(18, 42, 78, 0.08);
    padding-top: 10px;
  }

  #subcategory-section .sc-card__count {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
    background: rgba(18, 42, 78, 0.05);
    padding: 4px 8px;
    border-radius: 2px;
    white-space: nowrap;
  }

  #subcategory-section .sc-card__cta {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--orange-deep);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  #subcategory-section .sc-card__cta span {
    transition: transform 0.2s ease;
  }

  #subcategory-section .sc-card:hover .sc-card__cta {
    color: var(--orange);
  }

  #subcategory-section .sc-card:hover .sc-card__cta span {
    transform: translateX(3px);
  }

  /* Responsive — card count per viewport */
  @media (max-width: 1024px) {
    #subcategory-section .sc-track {
      gap: 16px;
    }

    #subcategory-section .sc-track > .sc-card {
      width: calc((100% - 16px) / 2);
    }
  }

  @media (max-width: 560px) {
    #subcategory-section .sc-track {
      gap: 14px;
    }

    #subcategory-section .sc-track > .sc-card {
      width: calc((100% - 14px) / 1.25);
    }

    #subcategory-section .sc-card__img {
      flex-basis: 120px;
      height: 120px;
      padding: 14px;
    }

    #subcategory-section .sc-card__body {
      padding: 14px 14px 12px;
    }
  }

  @media (max-width: 1024px) {
    #categories-section .mc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    #categories-section .mc-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>

<script is:inline>
(function () {
  var params = new URLSearchParams(window.location.search);

  var searchResults = document.getElementById('search-results');
  var searchGrid = document.getElementById('search-grid');
  var searchNo = document.getElementById('no-results');
  var searchQuery = document.getElementById('search-query-text');
  var catsSection = document.getElementById('categories-section');
  var subsSection = document.getElementById('subcategory-section');

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function highlight(el) {
    if (!el) return;
    el.scrollIntoView();
    el.classList.add('is-highlighted');
    window.setTimeout(function () { el.classList.remove('is-highlighted'); }, 1600);
  }

  // --- Deep-link: ?subcategory= or ?category= jumps to the matching card ---
  var subSlug = params.get('subcategory');
  var catSlug = params.get('category');
  if (subSlug) {
    var subLink = document.querySelector('[data-sub="' + subSlug + '"]');
    highlight(subLink);
  } else if (catSlug) {
    highlight(document.querySelector('[data-cat="' + catSlug + '"]'));
  }

  // --- Search (?q=): filter the two card grids ---
  var q = (params.get('q') || '').trim().toLowerCase();
  if (!q) return;

  var subs = Array.prototype.slice.call(document.querySelectorAll('.sc-card'));

  var subMatches = subs.filter(function (c) {
    return (c.getAttribute('data-search') || '').indexOf(q) !== -1;
  });

  var cards = subMatches.map(function (c) {
    return {
      href: c.getAttribute('href'),
      parent: c.querySelector('.sc-card__parent')?.textContent || '',
      name: c.querySelector('h3')?.textContent || '',
      desc: c.querySelector('p')?.textContent || ''
    };
  });

  searchQuery.textContent = 'Showing results for "' + escapeHtml(params.get('q')) + '"';

  if (cards.length > 0) {
    cards.forEach(function (item) {
      var a = document.createElement('a');
      a.href = item.href;
      a.className = 'sc-card';
      a.innerHTML =
          '<div class="sc-card__body">' +
            (item.parent ? '<span class="sc-card__parent">' + escapeHtml(item.parent) + '</span>' : '') +
            '<h3>' + escapeHtml(item.name) + '</h3>' +
            (item.desc ? '<p>' + escapeHtml(item.desc) + '</p>' : '') +
            '<div class="sc-card__meta"><span class="sc-card__cta">View <span aria-hidden="true">→</span></span></div>' +
          '</div>';
      searchGrid.appendChild(a);
    });
  } else {
    searchNo.style.display = 'block';
  }

  // Hide the regular browse sections once the user searched.
  catsSection.style.display = 'none';
  subsSection.style.display = 'none';
  searchResults.style.display = 'block';
})();
</script>

<script is:inline>
(function () {
  'use strict';

  var carousel = document.getElementById('sc-carousel');
  if (!carousel) return;

  var params = new URLSearchParams(window.location.search);
  if (params.get('q')) return;

  var viewport = carousel.querySelector('.sc-carousel__viewport');
  var track = carousel.querySelector('.sc-track');

  if (!viewport || !track) return;

  var reducedMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  if (reducedMotion) {
    viewport.style.scrollBehavior = 'auto';
  }

  var slides = Array.prototype.slice.call(track.children);

  // Deep link: ?subcategory= scrolls the strip to that card.
  var subSlug = params.get('subcategory');
  if (subSlug) {
    for (var i = 0; i < slides.length; i++) {
      if (slides[i].getAttribute('data-sub') === subSlug) {
        viewport.scrollLeft = slides[i].offsetLeft;
        break;
      }
    }
  }

  // ============================================================
  // Smooth autoplay — glides exactly one card per step with a
  // rAF-driven ease (no native snap fighting it), wraps around at
  // the end, and stops FOREVER as soon as the visitor touches or
  // scrolls, handing control back to them.
  // ============================================================
  var AUTO_DELAY = 3200;
  var GLIDE_MS = 520;
  var timer = null;
  var animFrame = null;
  var autoEnabled = true;
  var visible = false;
  var hovered = false;
  var focused = false;

  function step() {
    if (slides.length > 1) return slides[1].offsetLeft - slides[0].offsetLeft;
    return viewport.clientWidth || 1;
  }

  function maxScroll() { return viewport.scrollWidth - viewport.clientWidth; }

  function animateTo(targetX, duration) {
    var startX = viewport.scrollLeft;
    var dist = targetX - startX;
    if (Math.abs(dist) < 0.5) { schedule(); return; }

    // Toggle off snap + smooth while we move it ourselves, so every
    // step is a clean one-card glide instead of a native jump.
    viewport.style.scrollSnapType = 'none';
    viewport.style.scrollBehavior = 'auto';
    var startTime = null;

    function frame(ts) {
      if (!startTime) startTime = ts;
      var p = Math.min(1, (ts - startTime) / duration);
      var eased = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
      viewport.scrollLeft = startX + dist * eased;
      if (p < 1) {
        animFrame = window.requestAnimationFrame(frame);
      } else {
        animFrame = null;
        viewport.scrollLeft = targetX;
        viewport.style.scrollSnapType = '';
        viewport.style.scrollBehavior = '';
        schedule();
      }
    }
    animFrame = window.requestAnimationFrame(frame);
  }

  function cancelGlide() {
    if (animFrame) {
      window.cancelAnimationFrame(animFrame);
      animFrame = null;
    }
    viewport.style.scrollSnapType = '';
    viewport.style.scrollBehavior = '';
  }

  function advance() {
    timer = null;
    var max = maxScroll();
    if (max <= 1) return;
    var stride = step();
    var current = Math.round(viewport.scrollLeft / stride);
    var maxIdx = Math.round(max / stride);
    var target = current >= maxIdx ? 0 : (current + 1) * stride;

    if (reducedMotion) {
      viewport.scrollLeft = target;
      schedule();
    } else {
      animateTo(target, GLIDE_MS);
    }
  }

  function schedule() {
    stopTimer();
    if (!autoEnabled || reducedMotion || !visible || hovered || focused) return;
    timer = window.setTimeout(advance, AUTO_DELAY);
  }

  function stopTimer() {
    if (timer) {
      window.clearTimeout(timer);
      timer = null;
    }
  }

  // Any direct interaction kills autoplay for good — the visitor
  // takes over and scrolls at their own pace.
  function stopAutoForever() {
    autoEnabled = false;
    stopTimer();
    cancelGlide();
  }

  // Temporary pauses while reading-only hovering / keyboard focus.
  carousel.addEventListener('mouseenter', function () { hovered = true; stopTimer(); });
  carousel.addEventListener('mouseleave', function () { hovered = false; schedule(); });
  carousel.addEventListener('focusin', function () { focused = true; stopTimer(); });
  carousel.addEventListener('focusout', function () { focused = false; schedule(); });

  // Any touch / drag / wheel scroll stops the auto motion permanently.
  viewport.addEventListener('pointerdown', stopAutoForever);
  viewport.addEventListener('wheel', stopAutoForever, { passive: true });

  if (document.hidden !== undefined) {
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopTimer();
      else schedule();
    });
  }

  // Autoplay only while the carousel is actually on screen.
  if ('IntersectionObserver' in window) {
    var visibilityObserver = new IntersectionObserver(function (entries) {
      visible = !!entries[0] && entries[0].isIntersecting;
      if (visible) schedule();
      else stopTimer();
    }, { threshold: 0.25 });
    visibilityObserver.observe(carousel);
  } else {
    visible = true;
    schedule();
  }
})();
</script>