---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackButton from '../../components/BackButton.astro';
import { path } from '../../lib/site';
import { CONTACT } from '../../lib/contact';
import { getCatalogueData, resolveFirstImage } from '../../lib/db';

const catalogue = await getCatalogueData();
const { categories, subCategories } = catalogue;

function sizeLabel(count: number, colors = 0): string {
  const parts: string[] = [];
  parts.push(count > 0
    ? `${count} ${count === 1 ? 'size / model' : 'sizes / models'}`
    : 'range on request');
  if (colors > 1) parts.push(`${colors} colour${colors === 1 ? '' : 's'}`);
  return parts.join(' · ');
}

function colorCount(variants: Array<{ color: string | null }>): number {
  return new Set(variants.map(v => (v.color || '').trim()).filter(Boolean)).size;
}

// Category cards — the main ranges, numbered like a catalogue index.
const categoryCards = categories.map((cat, i) => ({
  index: String(i + 1).padStart(2, '0'),
  name: cat.name,
  slug: cat.slug,
  description: cat.description,
  image: resolveFirstImage(cat.image_url, cat.images[0]?.image_url),
  sizes: cat.variants,
  colors: colorCount(cat.variants),
  count: cat.variants.length,
  subCount: cat.sub_categories.length,
  href: path(`/categories/${cat.slug}`)
}));

// Category main images — used as a last-resort fallback for product cards.
const categoryImageBySlug = new Map(categories.map(cat => [cat.slug, cat.image_url]));

// Product cards — every actual product across all categories.
const productCards = subCategories.map(sub => ({
  name: sub.name,
  slug: sub.slug,
  categoryName: sub.category_name,
  categorySlug: sub.category_slug,
  description: sub.short_description || sub.description,
  image: resolveFirstImage(sub.image_url, sub.images[0]?.image_url, categoryImageBySlug.get(sub.category_slug)),
  sizes: sub.variants.length,
  colors: colorCount(sub.variants),
  href: path(`/categories/${sub.category_slug}/${sub.slug}`)
}));

const productSearch = productCards.map(p =>
  `${p.name} ${p.categoryName} ${p.description || ''}`.toLowerCase()
);
---

<Layout
  title="Products | Vinayak Plastics — Plastic Crates, Pallets & Waste Bins"
  description="Explore Vinayak Plastics product range — plastic crates, plastic pallets, waste bins / dustbins and hand pallet trucks. HDPE & PP industrial-grade material handling equipment."
>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-top">
        <p class="breadcrumb"><a href={path('/')}>Home</a> / Products</p>
        <BackButton href={path('/')} />
      </div>
      <h1 class="display-800">Our Product Range</h1>
      <p>Industrial-grade material handling and packaging equipment for warehouses, dairy, municipal, and commercial buyers.</p>
    </div>
  </section>

  <!-- ===== CATEGORY INDEX ===== -->
  <section class="section" id="categories-section">
    <div class="container">
      <header class="pl-head reveal">
        <p class="sec-index">Product Categories</p>
        <h2 class="display-700">Browse by product range</h2>
        <p>Every family, from compact crates to industrial pallets — pick a range to see the sizes, colours and products inside.</p>
      </header>

      {categoryCards.length > 0 ? (
        <div class="pl-cat-list">
          {categoryCards.map(card => (
            <a href={card.href} class="pl-cat reveal" data-cat={card.slug} aria-label={`Browse ${card.name}`}>
              <div class="pl-cat__index" aria-hidden="true">{card.index}</div>
              <div class="pl-cat__img">
                {card.image ? (
                  <img src={card.image} alt={`${card.name} — Vinayak Plastics`} width="480" height="360" loading="lazy" decoding="async" />
                ) : (
                  <span class="pl-cat__img-empty">{card.name}</span>
                )}
              </div>
              <div class="pl-cat__body">
                <h3>{card.name}</h3>
                {card.description && <p>{card.description}</p>}
                <div class="pl-cat__meta">
                  <span class="pl-chip">{card.count ? `${card.count} · ${card.count === 1 ? 'model' : 'models'}` : 'Range'}</span>
                  {card.subCount > 0 && <span class="pl-chip">{card.subCount} product{card.subCount === 1 ? '' : 's'}</span>}
                  {card.sizes.slice(0, 3).map(v => v.name).filter(Boolean).map(name => (
                    <span class="pl-chip pl-chip-outline">{name}</span>
                  ))}
                  {card.sizes.length > 3 && <span class="pl-chip pl-chip-outline">+{card.sizes.length - 3} more</span>}
                </div>
              </div>
              <span class="pl-cat__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="pl-empty reveal">
          <h3>Product catalogue coming soon</h3>
          <p>We are currently updating our product listings. Please check back shortly or <a href={path('/contact')}>contact us</a> directly for product information.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== ALL PRODUCTS ===== -->
  <section class="section section-warm" id="products-section">
    <div class="container">
      <header class="pl-head pl-head--left reveal">
        <p class="sec-index">All Products</p>
        <h2 class="display-700">Every product in one place</h2>
        <p>Search the full range or filter by category — each product shows its available sizes and colours.</p>
      </header>

      <div class="pl-filter reveal">
        <div class="pl-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
          <input type="search" id="pl-search-input" placeholder="Search products…" aria-label="Search products" autocomplete="off">
          <button type="button" id="pl-search-clear" aria-label="Clear search" hidden>&times;</button>
        </div>
        <div class="pl-chips" id="pl-chips" role="group" aria-label="Filter by category">
          {categoryCards.map(card => (
            <button type="button" class="pl-chip-btn" data-cat={card.slug}>{card.name}</button>
          ))}
        </div>
      </div>

      <div class="pl-results-info" id="pl-results-info" hidden aria-live="polite"></div>

      {productCards.length > 0 ? (
        <div class="pl-grid reveal" id="pl-grid">
          {productCards.map((card, i) => (
            <a
              href={card.href}
              class="pl-card"
              data-sub={card.slug}
              data-cat={card.categorySlug}
              data-search={productSearch[i]}
            >
              <div class="pl-card__img">
                {card.image ? (
                  <img src={card.image} alt={`${card.name} — ${card.categoryName}`} width="480" height="360" loading="lazy" decoding="async" />
                ) : (
                  <span class="pl-card__placeholder">{card.name}</span>
                )}
              </div>
              <div class="pl-card__body">
                <span class="pl-card__parent">{card.categoryName}</span>
                <h3>{card.name}</h3>
                {card.description && <p>{card.description}</p>}
                <div class="pl-card__meta">
                  <span class="pl-card__count">{sizeLabel(card.sizes, card.colors)}</span>
                  <span class="pl-card__cta">View Details <span aria-hidden="true">→</span></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="pl-empty reveal">
          <h3>Product types coming soon</h3>
          <p>We are adding detailed product breakdowns. Please check back or <a href={path('/contact')}>contact us</a> for the full range.</p>
        </div>
      )}

      <div class="pl-empty" id="pl-no-results" hidden>
        <h3>No matching products</h3>
        <p id="pl-no-results-text">No products match your search. Try a different term or clear the filters.</p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label="Get a quote">
    <div class="container reveal">
      <h2 class="display-700">Need Product Specs or Pricing?</h2>
      <p>Call or WhatsApp us directly for detailed dimensions, material grades, and dispatch timelines.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ==========================================================
     Products page — redesigned catalogue index
     ========================================================== */

  .pl-head {
    text-align: center;
    margin-bottom: 44px;
  }
  .pl-head--left {
    text-align: left;
  }
  .pl-head .sec-index {
    justify-content: center;
  }
  .pl-head--left .sec-index {
    justify-content: flex-start;
  }
  .pl-head h2 {
    color: var(--deep-navy);
    margin-bottom: 10px;
  }
  .pl-head p:not(.sec-index) {
    color: var(--steel);
    font-size: 1.05rem;
    max-width: 640px;
    margin: 0 auto;
  }
  .pl-head--left p:not(.sec-index) {
    margin: 0;
  }

  /* ---------- Category index cards (photo-forward) ---------- */
  .pl-cat-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .pl-cat {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid rgba(18, 42, 78, 0.08);
    border-top: 3px solid var(--orange);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 2px rgba(18, 42, 78, 0.04);
    overflow: hidden;
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .pl-cat:hover,
  .pl-cat:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 18px 44px rgba(18, 42, 78, 0.12);
  }

  .pl-cat__index {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--orange);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1;
    box-shadow: 0 4px 14px rgba(18, 42, 78, 0.22);
    user-select: none;
  }

  .pl-cat__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 20px 22px 18px;
  }

  .pl-cat__body h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--deep-navy);
    margin-bottom: 6px;
  }

  .pl-cat__body p {
    color: var(--steel);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pl-cat__meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-right: 6px;
  }

  .pl-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--orange-deep);
    background: rgba(232, 99, 12, 0.1);
    padding: 4px 10px;
    border-radius: 100px;
    white-space: nowrap;
  }
  .pl-chip-outline {
    color: var(--steel);
    background: rgba(18, 42, 78, 0.06);
  }

  .pl-cat__img {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--warm-off-white);
    border-bottom: 1px solid rgba(18, 42, 78, 0.06);
  }
  .pl-cat__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pl-cat:hover .pl-cat__img img {
    transform: scale(1.035);
  }
  .pl-cat__img-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    padding: 20px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    text-align: center;
    color: rgba(18, 42, 78, 0.25);
  }

  .pl-cat__arrow {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--orange-deep);
    background: #fff;
    box-shadow: 0 4px 14px rgba(18, 42, 78, 0.18);
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .pl-cat__arrow svg { width: 20px; height: 20px; }
  .pl-cat:hover .pl-cat__arrow {
    transform: translateX(4px);
    background: var(--orange);
    color: #fff;
  }

  /* ---------- Filter bar ---------- */
  .pl-filter {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .pl-search {
    position: relative;
    max-width: 460px;
  }
  .pl-search svg {
    position: absolute;
    left: 16px;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    color: var(--steel);
    pointer-events: none;
  }
  .pl-search input {
    width: 100%;
    height: 50px;
    padding: 0 46px 0 46px;
    border: 1px solid rgba(18, 42, 78, 0.14);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    background: #fff;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .pl-search input:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(232, 99, 12, 0.14);
  }
  .pl-search input::placeholder { color: rgba(91, 100, 114, 0.7); }
  .pl-search button {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: rgba(18, 42, 78, 0.07);
    color: var(--steel);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .pl-search button:hover { background: rgba(232, 99, 12, 0.16); color: var(--orange-deep); }

  .pl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pl-chip-btn {
    border: 1px solid rgba(18, 42, 78, 0.14);
    background: #fff;
    color: var(--deep-navy);
    border-radius: 100px;
    padding: 8px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .pl-chip-btn:hover { border-color: var(--orange); color: var(--orange-deep); }
  .pl-chip-btn.is-active {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
  }

  .pl-results-info {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 14px;
  }

  /* ---------- Product grid ---------- */
  .pl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .pl-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid rgba(18, 42, 78, 0.08);
    border-top: 3px solid var(--orange);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 2px rgba(18, 42, 78, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
  }
  .pl-card:hover,
  .pl-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(18, 42, 78, 0.12);
  }

  .pl-card__img {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--warm-off-white);
    border-bottom: 1px solid rgba(18, 42, 78, 0.06);
  }
  .pl-card__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 16px;
  }
  .pl-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    color: rgba(18, 42, 78, 0.25);
  }

  .pl-card__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 18px 18px 16px;
  }
  .pl-card__parent {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange-deep);
    margin-bottom: 5px;
    padding-bottom: 6px;
    position: relative;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pl-card__parent::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 20px;
    height: 2px;
    background: var(--orange);
  }
  .pl-card__body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--deep-navy);
    margin-bottom: 8px;
  }
  .pl-card__body p {
    color: var(--steel);
    font-size: 0.86rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .pl-card__meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid rgba(18, 42, 78, 0.08);
    padding-top: 11px;
  }
  .pl-card__count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
    background: rgba(18, 42, 78, 0.05);
    padding: 4px 8px;
    border-radius: 2px;
  }
  .pl-card__cta {
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--orange-deep);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .pl-card__cta span { transition: transform 0.2s ease; }
  .pl-card:hover .pl-card__cta { color: var(--orange); }
  .pl-card:hover .pl-card__cta span { transform: translateX(3px); }

  .pl-empty {
    text-align: center;
    padding: 48px 20px;
    background: #fff;
    border: 1px dashed rgba(18, 42, 78, 0.16);
    border-radius: var(--radius-md);
  }
  .pl-empty h3 { font-family: var(--font-display); font-size: 1.4rem; text-transform: uppercase; color: var(--deep-navy); margin-bottom: 8px; }
  .pl-empty p { color: var(--steel); font-size: 0.95rem; }
  .pl-empty a { color: var(--orange-deep); text-decoration: underline; }
  .pl-empty a:hover { color: var(--orange); }

  /* Deep-link highlight pulse */
  .is-highlighted {
    animation: pl-pulse 1.6s ease;
    border-color: var(--orange);
  }
  @keyframes pl-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(232, 99, 12, 0); }
    30% { box-shadow: 0 0 0 6px rgba(232, 99, 12, 0.18); }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .pl-grid { grid-template-columns: repeat(2, 1fr); }
    .pl-cat-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .pl-grid { grid-template-columns: 1fr; }
    .pl-cat-list { grid-template-columns: 1fr; }
    .pl-cat__body { padding: 16px 16px 14px; }
    .pl-cat__index { width: 40px; height: 40px; font-size: 0.9rem; }
    .pl-cat__arrow { width: 36px; height: 36px; }
  }
</style>

<script is:inline>
(function () {
  'use strict';
  var params = new URLSearchParams(window.location.search);
  var q = (params.get('q') || '').trim();

  var searchInput = document.getElementById('pl-search-input');
  var searchClear = document.getElementById('pl-search-clear');
  var chipsEl = document.getElementById('pl-chips');
  var resultsInfo = document.getElementById('pl-results-info');
  var grid = document.getElementById('pl-grid');
  var noResults = document.getElementById('pl-no-results');
  var noResultsText = document.getElementById('pl-no-results-text');
  if (!grid) { if (searchInput) searchInput.value = q; return; }

  var cards = Array.prototype.slice.call(grid.querySelectorAll('.pl-card'));

  function highlight(el) {
    if (!el) return;
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    el.classList.add('is-highlighted');
    window.setTimeout(function () { el.classList.remove('is-highlighted'); }, 1800);
  }

  // Deep-links: ?subproduct= scrolls to a product card, ?category= to a range card.
  var subLink = document.querySelector('[data-sub="' + (params.get('subproduct') || '') + '"]');
  var catLink = document.querySelector('[data-cat="' + (params.get('category') || '') + '"]');
  if (!params.get('q')) {
    if (subLink) { scrollToSectionAnd(subLink); }
    else if (catLink) { scrollToSectionAnd(catLink); }
  }

  function scrollToSectionAnd(target) {
    var section = document.getElementById('products-section') || document.getElementById('categories-section');
    if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    window.setTimeout(function () { highlight(target); }, 420);
  }

  var activeCat = '';

  function update() {
    var term = (searchInput ? searchInput.value : '').trim().toLowerCase();
    var visible = 0;

    cards.forEach(function (card) {
      var matchCat = !activeCat || card.getAttribute('data-cat') === activeCat;
      var matchTerm = !term || (card.getAttribute('data-search') || '').indexOf(term) !== -1;
      var show = matchCat && matchTerm;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (searchClear) {
      searchClear.hidden = !term && !activeCat;
      searchClear.style.display = (!term && !activeCat) ? 'none' : '';
    }
    grid.style.display = visible || (!term && !activeCat) ? '' : 'none';

    if (resultsInfo) {
      var searching = Boolean(term || activeCat);
      resultsInfo.hidden = !searching;
      if (searching) {
        resultsInfo.textContent = 'Showing ' + visible + (visible === 1 ? ' product' : ' products') +
          (term ? ' for "' + term + '"' : '') + (activeCat ? ' in ' + activeCat : '');
      }
    }

    var noResultsVisible = visible === 0;
    if (noResults) noResults.hidden = !noResultsVisible;
    if (noResultsText) {
      noResultsText.textContent = activeCat && !term
        ? 'No products in this range yet. Choose another category or ask us directly.'
        : 'No products match your search. Try a different term or clear the filters.';
    }
  }

  // Brand the nav search through: ?q= arrives pre-populated.
  if (q) {
    if (searchInput) searchInput.value = q;
    var catsSection = document.getElementById('categories-section');
    if (catsSection) catsSection.scrollIntoView({ behavior: 'auto', block: 'start' });
  }

  if (searchInput) {
    searchInput.addEventListener('input', update);
  }
  if (searchClear) {
    searchClear.addEventListener('click', function () {
      if (searchInput) searchInput.value = '';
      activeCat = '';
      document.querySelectorAll('.pl-chip-btn.is-active').forEach(function (b) { b.classList.remove('is-active'); });
      update();
      if (searchInput) searchInput.focus();
    });
  }
  if (chipsEl) {
    chipsEl.querySelectorAll('.pl-chip-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeCat = btn.classList.contains('is-active') ? '' : (btn.getAttribute('data-cat') || '');
        chipsEl.querySelectorAll('.pl-chip-btn').forEach(function (b) { b.classList.remove('is-active'); });
        if (activeCat) btn.classList.add('is-active');
        update();
      });
    });
  }

  update();
})();
</script>