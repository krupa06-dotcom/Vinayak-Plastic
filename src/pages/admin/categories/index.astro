---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { path } from '../../../lib/site';
---

<AdminLayout title="Categories" current="categories">
  <div class="a-page-head">
    <h2>Categories</h2>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <a href={path('/admin/products/')} class="a-btn">&larr; Back</a>
      <button type="button" class="a-btn a-btn-primary" id="add-cat-toggle">+ Add Category</button>
    </div>
  </div>

  <div class="a-card" id="add-cat-form" style="display:none;">
    <div class="a-card-head">
      <h2>New Category</h2>
      <button type="button" class="a-btn a-btn-sm" id="add-cat-close">&times;</button>
    </div>
    <div class="a-card-body">
      <form id="cat-form" novalidate>
        <div class="a-form-grid">
          <div class="a-field">
            <label for="cat-name">Name <span style="color:var(--a-danger)">*</span></label>
            <input id="cat-name" class="a-input" required autocomplete="off" placeholder="e.g. Plastic Crates" />
          </div>
          <div class="a-field">
            <label for="cat-slug">Slug</label>
            <input id="cat-slug" class="a-input" required autocomplete="off" placeholder="auto-generated from name" />
            <span class="a-hint">Leave blank to auto-generate.</span>
          </div>
          <div class="a-field a-field-full">
            <label for="cat-image">Main image</label>
            <div id="cat-image"></div>
          </div>
          <div class="a-field a-field-full">
            <label for="cat-description">Description</label>
            <textarea id="cat-description" class="a-textarea" rows="3" placeholder="What this range is and where it is used"></textarea>
          </div>
          <div class="a-field">
            <label for="cat-order">Display order</label>
            <input id="cat-order" class="a-input" type="number" min="0" value="0" />
            <span class="a-hint">Lower numbers appear first.</span>
          </div>
          <div class="a-field">
            <label>&nbsp;</label>
            <label class="a-check"><input type="checkbox" id="cat-active" checked /> Active</label>
          </div>
        </div>
        <div id="cat-form-error" class="a-tip a-tip-error" style="margin-top:12px;display:none;" role="alert"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
          <button type="button" class="a-btn" id="add-cat-cancel">Cancel</button>
          <button type="submit" class="a-btn a-btn-primary" id="cat-submit">Add Category</button>
        </div>
      </form>
    </div>
  </div>

  <div class="a-card">
    <div class="a-card-body" id="cat-list" style="padding:6px 0 0;">
      <div class="a-inline-loading" style="padding:30px;"><div class="a-spinner"></div></div>
    </div>
  </div>

  <script>
    import { gate, supabase, esc, slugify, activeBadge, showError, showEmpty, confirmDialog, toast, publicUrl } from '../../../scripts/admin/core';
    import { createImagePicker } from '../../../scripts/admin/imagePicker';

    const BASE: string = (window as any).__VP_SUPABASE__?.base ?? '/';
    const href = (p: string) => `${BASE.replace(/\/$/, '')}/${p.replace(/^\//, '')}`.replace(/\/+/g, '/');

    interface CatRow { id: string; name: string; slug: string; is_active: boolean; image_url?: string | null }
    interface SubRow { id: string; category_id: string; is_active: boolean }

    const formEl = document.getElementById('cat-form') as HTMLFormElement;
    const formCardEl = document.getElementById('add-cat-form') as HTMLElement;
    const toggleBtn = document.getElementById('add-cat-toggle') as HTMLButtonElement;
    const nameEl = document.getElementById('cat-name') as HTMLInputElement;
    const slugEl = document.getElementById('cat-slug') as HTMLInputElement;
    const descEl = document.getElementById('cat-description') as HTMLTextAreaElement;
    const orderEl = document.getElementById('cat-order') as HTMLInputElement;
    const activeEl = document.getElementById('cat-active') as HTMLInputElement;
    const errorEl = document.getElementById('cat-form-error');
    const submitBtn = document.getElementById('cat-submit') as HTMLButtonElement;

    const picker = createImagePicker(document.getElementById('cat-image')!, {
      hint: 'Choose a photo from your computer. This is the category cover shown across the website.'
    });

    function setError(msg: string) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.style.display = msg ? '' : 'none';
    }

    function openForm() {
      setError('');
      formCardEl.style.display = '';
      toggleBtn.style.display = 'none';
      formCardEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      nameEl.focus();
    }

    function closeForm() {
      formCardEl.style.display = 'none';
      toggleBtn.style.display = '';
      formEl.reset();
      slugEl.removeAttribute('data-manual');
      orderEl.value = '0';
      activeEl.checked = true;
      picker.setValue({ existing: null, file: null });
      setError('');
    }

    toggleBtn.addEventListener('click', openForm);
    document.getElementById('add-cat-close')?.addEventListener('click', closeForm);
    document.getElementById('add-cat-cancel')?.addEventListener('click', closeForm);

    nameEl.addEventListener('input', () => {
      if (!slugEl.hasAttribute('data-manual')) slugEl.value = slugify(nameEl.value);
    });
    slugEl.addEventListener('input', () => slugEl.setAttribute('data-manual', '1'));

    async function load() {
      const listEl = document.getElementById('cat-list');
      if (!listEl) return;

      const [catsRes, subsRes] = await Promise.all([
        supabase.from('categories').select('id, name, slug, is_active, display_order, image_url').order('display_order'),
        supabase.from('sub_categories').select('id, category_id, is_active')
      ]);

      if (catsRes.error) { showError(listEl, catsRes.error.message); return; }
      if (subsRes.error) { showError(listEl, subsRes.error.message); return; }

      const cats = (catsRes.data || []) as CatRow[];
      const subs = (subsRes.data || []) as SubRow[];

      if (!cats.length) {
        showEmpty(listEl, 'No categories yet', 'Categories are the main ranges shown first on the Products page. Create your first category to get started.',
          `<button type="button" class="a-btn a-btn-primary" data-cat-openform>+ Add Category</button>`);
        listEl.querySelector<HTMLButtonElement>('[data-cat-openform]')?.addEventListener('click', openForm);
        return;
      }

      listEl.innerHTML = `
        <div class="a-table-wrap">
          <table class="a-table">
            <thead><tr>
              <th>Category</th><th>Contents</th><th style="width:110px">Status</th><th style="width:230px">Actions</th>
            </tr></thead>
            <tbody>
              ${cats.map(c => {
                const catProds = subs.filter(s => s.category_id === c.id);
                return `
                  <tr data-name="${esc((c.name + ' ' + c.slug).toLowerCase())}">
                    <td>
                      <div style="display:flex;align-items:center;gap:10px;min-width:220px;">
                        ${c.image_url ? `<img src="${esc(publicUrl(c.image_url))}" alt="" class="a-thumb" style="width:44px;height:36px;flex-shrink:0;" loading="lazy" />` : ''}
                        <div>
                          <strong>${esc(c.name)}</strong>
                          <div style="font-size:0.72rem;color:var(--a-faint);">${esc(c.slug)}</div>
                        </div>
                      </div>
                    </td>
                    <td><span class="a-chip">${catProds.length} product${catProds.length === 1 ? '' : 's'}</span></td>
                    <td>${activeBadge(c.is_active)}</td>
                    <td class="a-actions">
                      <a href="${href(`admin/products/edit/?category=${c.id}`)}" class="a-btn a-btn-sm">Edit</a>
                      <button type="button" class="a-btn a-btn-sm a-btn-danger" data-delete-cat="${c.id}">Delete</button>
                    </td>
                  </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>`;

      listEl.querySelectorAll<HTMLButtonElement>('[data-delete-cat]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.deleteCat!;
          const cat = cats.find(c => c.id === id);
          const ok = await confirmDialog(`Delete "${cat?.name ?? 'category'}"?`,
            'This permanently deletes the category, all of its products, sizes and images. This cannot be undone.');
          if (!ok) return;
          const { error } = await supabase.from('categories').delete().eq('id', id);
          if (error) { toast(error.message, 'error'); return; }
          toast('Category deleted.', 'success');
          await load();
        });
      });
    }

    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      setError('');
      const name = nameEl.value.trim();
      if (!name) { setError('A name is required.'); return; }
      const slug = slugEl.value.trim() || slugify(name);

      submitBtn?.setAttribute('disabled', '');
      submitBtn.textContent = 'Saving…';

      const pickerValue = picker.getValue();
      let imageUrl: string | null = pickerValue.existing;

      if (pickerValue.file) {
        const result = await picker.upload(`media/categories/${slug}-${Date.now()}`);
        if ('error' in result) {
          submitBtn?.removeAttribute('disabled');
          submitBtn.textContent = 'Add Category';
          setError(result.error);
          return;
        }
        imageUrl = result.url;
      }

      const { error } = await supabase.from('categories').insert({
        id: crypto.randomUUID(),
        name,
        slug,
        description: descEl.value.trim() || null,
        image_url: imageUrl,
        display_order: Number(orderEl.value) || 0,
        is_active: activeEl.checked,
        updated_at: new Date().toISOString()
      } as never);

      submitBtn?.removeAttribute('disabled');
      submitBtn.textContent = 'Add Category';

      if (error) { setError(error.message); return; }
      toast('Category created.', 'success');
      closeForm();
      await load();
    });

    void (async () => { if (await gate()) await load(); })();
  </script>
</AdminLayout>