---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { path } from '../../../lib/site';
---

<AdminLayout title="Products" current="products">
  <div class="a-page-head">
    <h2>Products</h2>
    <a href={path('/admin/products/edit/')} class="a-btn a-btn-orange a-btn-plus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>Add Product</a>
  </div>

  <div class="a-card">
    <div class="a-toolbar" style="flex-wrap:wrap;">
      <input type="search" id="prod-search" class="a-input" placeholder="Search name, slug, SKU…" />
      <select id="prod-cat-filter" class="a-select">
        <option value="">All Categories</option>
      </select>
      <select id="prod-sub-filter" class="a-select">
        <option value="">All Sub-categories</option>
      </select>
      <select id="prod-status-filter" class="a-select">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
        <option value="featured">Featured</option>
      </select>
      <span style="flex:1"></span>
      <span id="prod-count" style="font-size:0.84rem;color:var(--a-muted);"></span>
    </div>

    <div class="a-card-body" id="prod-list" style="padding:6px 0 0;">
      <div class="a-inline-loading" style="padding:30px;"><div class="a-spinner"></div></div>
    </div>

    <div class="a-pagination" id="prod-pagination" style="display:none;"></div>
  </div>

  <script>
    import { gate, supabase, esc, publicUrl, activeBadge, featuredBadge, showError, showEmpty, confirmDialog, toast } from '../../../scripts/admin/core';

    const BASE: string = (window as any).__VP_SUPABASE__?.base ?? '/';
    const href = (p: string) => `${BASE.replace(/\/$/, '')}/${p.replace(/^\//, '')}`.replace(/\/+/g, '/');

    const params = new URLSearchParams(window.location.search);

    const PAGE_SIZE = 20;
    let currentPage = 0;
    let totalCount = 0;
    let catsData: any[] = [];
    let subsData: any[] = [];
    let variantCounts: Record<string, number> = {};

    const searchEl = document.getElementById('prod-search') as HTMLInputElement;
    const catEl = document.getElementById('prod-cat-filter') as HTMLSelectElement;
    const subEl = document.getElementById('prod-sub-filter') as HTMLSelectElement;
    const statusEl = document.getElementById('prod-status-filter') as HTMLSelectElement;
    const countEl = document.getElementById('prod-count')!;
    const listEl = document.getElementById('prod-list')!;
    const pagEl = document.getElementById('prod-pagination')!;
    let debounceTimer: number;

    function getFilters() {
      return {
        search: searchEl.value.trim().toLowerCase(),
        catId: catEl.value,
        subId: subEl.value,
        status: statusEl.value
      };
    }

    function renderSubSelect() {
      const { catId } = getFilters();
      const subs = catId
        ? subsData.filter(s => s.category_id === catId)
        : subsData;
      subEl.innerHTML = '<option value="">All Sub-categories</option>';
      if (catId) {
        subEl.innerHTML += subs.map((s: any) =>
          `<option value="${s.id}" ${s.id === params.get('sub') ? 'selected' : ''}>${esc(s.name)}</option>`).join('');
      } else {
        const grouped: Record<string, any[]> = {};
        subs.forEach((s: any) => { (grouped[s.category_id] = grouped[s.category_id] || []).push(s); });
        subEl.innerHTML += catsData.map((c: any) => {
          const options = (grouped[c.id] || []).map((s: any) => `<option value="${s.id}">${esc(s.name)}</option>`).join('');
          return options ? `<optgroup label="${esc(c.name)}">${options}</optgroup>` : '';
        }).join('');
      }
      if (params.get('sub')) subEl.value = params.get('sub') || '';
    }

    async function load() {
      const { search, catId, subId, status } = getFilters();
      listEl.innerHTML = '<div class="a-inline-loading" style="padding:30px;"><div class="a-spinner"></div></div>';
      pagEl.style.display = 'none';
      countEl.textContent = '';

      let query = supabase
        .from('products')
        .select(`
          id, name, slug, product_code, is_active, is_featured, display_order, updated_at,
          sub_category:sub_categories ( id, name, category_id ),
          product_images ( image_url, display_order )
        `, { count: 'exact' })
        .order('display_order', { ascending: true });

      if (search) {
        query = query.or(`name.ilike.%${search}%,slug.ilike.%${search}%,product_code.ilike.%${search}%`);
      }
      if (subId) {
        query = query.eq('sub_category_id', subId);
      } else if (catId) {
        const subIds = subsData.filter(s => s.category_id === catId).map(s => s.id);
        if (subIds.length) {
          query = query.in('sub_category_id', subIds);
        } else {
          showEmpty(listEl, 'No products in this category', 'Add a sub-category first, then products.');
          return;
        }
      }
      if (status === 'active') query = query.eq('is_active', true);
      else if (status === 'inactive') query = query.eq('is_active', false);
      else if (status === 'featured') query = query.eq('is_featured', true);

      const from = currentPage * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;
      query = query.range(from, to);

      const { data, error, count } = await query;

      if (error) { showError(listEl, error.message); return; }
      totalCount = count ?? 0;
      countEl.textContent = `${totalCount.toLocaleString()} product${totalCount === 1 ? '' : 's'}`;

      if (!data?.length) {
        showEmpty(listEl, 'No products found', 'Create your first product or adjust your filters.',
          `<a href="${href('admin/products/edit/')}" class="a-btn a-btn-primary">+ New Product</a>`);
        return;
      }

      const firstImg = (imgs: any[]) => imgs?.sort((a: any, b: any) => (a.display_order ?? 0) - (b.display_order ?? 0))[0];

      listEl.innerHTML = `
        <div class="a-table-wrap">
          <table class="a-table">
            <thead><tr>
              <th></th><th>Product</th><th>Category / Sub-category</th><th>Sizes &amp; Shapes</th><th>Status</th><th>Featured</th><th>Updated</th><th style="width:130px">Actions</th>
            </tr></thead>
            <tbody>${data.map((p: any) => {
              const img = firstImg(p.product_images);
              const imgUrl = img ? publicUrl(img.image_url) : '';
              const sc = p.sub_category as any;
              const catName = catsData.find(c => c.id === sc?.category_id)?.name ?? '—';
              const scName = sc?.name ?? '—';
              const vCount = variantCounts[p.id] ?? 0;
              return `
              <tr>
                <td>${imgUrl ? `<img src="${esc(imgUrl)}" alt="" class="a-thumb" loading="lazy" />` : '<div class="a-thumb" style="display:flex;align-items:center;justify-content:center;color:#cbd5e1;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>'}</td>
                <td>
                  <a href="${href(`admin/products/edit/?id=${p.id}`)}" style="font-weight:600;color:var(--a-navy);">${esc(p.name)}</a><br>
                  <span style="font-size:0.75rem;color:var(--a-faint)">${esc(p.product_code || p.slug)}</span>
                </td>
                <td>
                  <span style="font-size:0.8rem;">${esc(scName)}</span><br>
                  <span style="font-size:0.75rem;color:var(--a-faint)">${esc(catName)}</span>
                </td>
                <td>${vCount > 0
                    ? `<span class="a-chip a-chip-ok">${vCount} size${vCount === 1 ? '' : 's'}</span>`
                    : `<span class="a-chip a-chip-warn">Add sizes</span>`}</td>
                <td>${activeBadge(p.is_active)}</td>
                <td>${p.is_featured ? featuredBadge() : ''}</td>
                <td style="white-space:nowrap;font-size:0.82rem;color:var(--a-muted)">${p.updated_at ? new Date(p.updated_at).toLocaleDateString('en-IN') : '—'}</td>
                <td class="a-actions">
                  <a href="${href(`admin/products/edit/?id=${p.id}`)}" class="a-btn a-btn-sm">Edit</a>
                  <button type="button" class="a-btn a-btn-sm a-btn-danger" data-delete-id="${p.id}">Delete</button>
                </td>
              </tr>`;
            }).join('')}</tbody>
          </table>
        </div>`;

      const totalPages = Math.ceil(totalCount / PAGE_SIZE);
      pagEl.style.display = totalPages > 1 ? '' : 'none';
      pagEl.innerHTML = `
        <span>${totalCount.toLocaleString()} product${totalCount === 1 ? '' : 's'}</span>
        <span style="flex:1"></span>
        <button class="a-btn a-btn-sm" data-page="prev" ${currentPage === 0 ? 'disabled' : ''}>&laquo; Previous</button>
        <span style="font-size:0.82rem;">Page ${currentPage + 1} of ${totalPages}</span>
        <button class="a-btn a-btn-sm" data-page="next" ${currentPage + 1 >= totalPages ? 'disabled' : ''}>Next &raquo;</button>`;

      pagEl.querySelector('[data-page="prev"]')?.addEventListener('click', () => { currentPage--; load(); });
      pagEl.querySelector('[data-page="next"]')?.addEventListener('click', () => { currentPage++; load(); });

      listEl.querySelectorAll<HTMLButtonElement>('[data-delete-id]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.deleteId!;
          const ok = await confirmDialog('Delete product?',
            'This permanently deletes the product and all of its sizes, images and spec rows. This cannot be undone.');
          if (!ok) return;
          const { error: vErr } = await supabase.from('product_variants').delete().eq('product_id', id);
          const { error: delImgErr } = await supabase.from('product_images').delete().eq('product_id', id);
          const { error: delSpecErr } = await supabase.from('product_specifications').delete().eq('product_id', id);
          const { error: delProdErr } = await supabase.from('products').delete().eq('id', id);
          const err = vErr || delImgErr || delSpecErr || delProdErr;
          if (err) { toast(err.message, 'error'); return; }
          toast('Product deleted.', 'success');
          await load();
        });
      });
    }

    searchEl?.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => { currentPage = 0; load(); }, 280);
    });
    catEl?.addEventListener('change', () => { currentPage = 0; renderSubSelect(); load(); });
    subEl?.addEventListener('change', () => { currentPage = 0; load(); });
    statusEl?.addEventListener('change', () => { currentPage = 0; load(); });

    void (async () => {
      if (!(await gate())) return;

      const [catsRes, subsRes, varRes] = await Promise.all([
        supabase.from('categories').select('id, name').order('display_order'),
        supabase.from('sub_categories').select('id, category_id, name').order('display_order'),
        supabase.from('product_variants').select('product_id')
      ]);

      catsData = (catsRes.data || []) as any[];
      subsData = (subsRes.data || []) as any[];
      variantCounts = {};
      (varRes.data || []).forEach((v: any) => { variantCounts[v.product_id] = (variantCounts[v.product_id] ?? 0) + 1; });

      catEl.innerHTML = `<option value="">All Categories</option>` +
        catsData.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');

      const preselect = params.get('sub');
      if (preselect) {
        const sub = subsData.find(s => s.id === preselect);
        if (sub) catEl.value = sub.category_id;
      }
      renderSubSelect();
      await load();
    })();
  </script>
</AdminLayout>