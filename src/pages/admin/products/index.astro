---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { path } from '../../../lib/site';
---

<AdminLayout title="Products" current="products">
  <div class="a-card">
    <div class="a-toolbar" style="flex-wrap:wrap;">
      <input type="search" id="prod-search" class="a-input" placeholder="Search name, slug, SKU…" />
      <select id="prod-cat-filter" class="a-select">
        <option value="">All Categories</option>
      </select>
      <select id="prod-status-filter" class="a-select">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
        <option value="featured">Featured</option>
      </select>
      <span style="flex:1"></span>
      <a href={path('/admin/products/edit/')} class="a-btn a-btn-primary">+ New Product</a>
    </div>

    <div class="a-card-body" id="prod-list">
      <div class="a-inline-loading"><div class="a-spinner"></div></div>
    </div>

    <div class="a-pagination" id="prod-pagination" style="display:none;"></div>
  </div>

  <script>
    import { gate, supabase, esc, publicUrl, activeBadge, featuredBadge, showError, showEmpty, confirmDialog, toast } from '../../../scripts/admin/core';

    const BASE: string = (window as any).__VP_SUPABASE__?.base ?? '/';
    const href = (p: string) => `${BASE.replace(/\/$/, '')}/${p.replace(/^\//, '')}`.replace(/\/+/g, '/');

    const PAGE_SIZE = 20;
    let currentPage = 0;
    let totalCount = 0;

    const searchEl = document.getElementById('prod-search') as HTMLInputElement;
    const catEl = document.getElementById('prod-cat-filter') as HTMLSelectElement;
    const statusEl = document.getElementById('prod-status-filter') as HTMLSelectElement;
    const listEl = document.getElementById('prod-list')!;
    const pagEl = document.getElementById('prod-pagination')!;
    let debounceTimer: number;

    function getFilters(): { search: string; catId: string; status: string } {
      return {
        search: searchEl.value.trim().toLowerCase(),
        catId: catEl.value,
        status: statusEl.value
      };
    }

    async function load() {
      const { search, catId, status } = getFilters();
      listEl.innerHTML = '<div class="a-inline-loading"><div class="a-spinner"></div></div>';
      pagEl.style.display = 'none';

      let query = supabase
        .from('products')
        .select(`
          id, name, slug, product_code, is_active, is_featured, display_order, updated_at,
          sub_category:sub_categories ( id, name, category_id ),
          product_images ( image_url, display_order )
        `, { count: 'exact' })
        .order('display_order', { ascending: true });

      if (search) {
        query = query.or(`name.ilike.%${search}%,slug.ilike.%${search}%,product_code.ilike.%${search}%`);
      }
      if (catId) {
        // get sub-category IDs for this category
        const { data: subs } = await supabase.from('sub_categories').select('id').eq('category_id', catId);
        const subIds = (subs || []).map((s: any) => s.id);
        if (subIds.length) {
          query = query.in('sub_category_id', subIds);
        } else {
          // no sub-categories in this category → no products match
          showEmpty(listEl, 'No products in this category', 'Try a different filter.');
          return;
        }
      }
      if (status === 'active') query = query.eq('is_active', true);
      else if (status === 'inactive') query = query.eq('is_active', false);
      else if (status === 'featured') query = query.eq('is_featured', true);

      const from = currentPage * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;
      query = query.range(from, to);

      const { data, error, count } = await query;

      if (error) { showError(listEl, error.message); return; }
      totalCount = count ?? 0;

      if (!data?.length) {
        showEmpty(listEl, 'No products found', 'Create your first product or adjust your filters.',
          `<a href="${href('admin/products/edit/')}" class="a-btn a-btn-primary">+ New Product</a>`);
        return;
      }

      // Thumbnail: first product image
      const firstImg = (imgs: any[]) => imgs?.sort((a: any, b: any) => (a.display_order ?? 0) - (b.display_order ?? 0))[0];

      listEl.innerHTML = `
        <div class="a-table-wrap">
          <table class="a-table">
            <thead><tr>
              <th></th><th>Name</th><th>SKU</th><th>Sub-category</th><th>Status</th><th>Featured</th><th>Updated</th><th style="width:130px">Actions</th>
            </tr></thead>
            <tbody>${data.map((p: any) => {
              const img = firstImg(p.product_images);
              const imgUrl = img ? publicUrl(img.image_url) : '';
              const catName = p.sub_category?.name ?? '—';
              return `
              <tr>
                <td>${imgUrl ? `<img src="${esc(imgUrl)}" alt="" class="a-thumb" loading="lazy" />` : '<div class="a-thumb" style="display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#ccc;">📦</div>'}</td>
                <td>
                  <a href="${href(`admin/products/edit/?id=${p.id}`)}" style="font-weight:600;color:var(--a-navy);">${esc(p.name)}</a>
                </td>
                <td style="color:var(--a-muted)">${esc(p.product_code || '—')}</td>
                <td>${esc(catName)}</td>
                <td>${activeBadge(p.is_active)}</td>
                <td>${p.is_featured ? featuredBadge() : ''}</td>
                <td style="white-space:nowrap;font-size:0.82rem;color:var(--a-muted)">${p.updated_at ? new Date(p.updated_at).toLocaleDateString('en-IN') : '—'}</td>
                <td class="a-actions">
                  <a href="${href(`admin/products/edit/?id=${p.id}`)}" class="a-btn a-btn-sm">Edit</a>
                  <button type="button" class="a-btn a-btn-sm a-btn-danger" data-delete-id="${p.id}">Delete</button>
                </td>
              </tr>`;
            }).join('')}</tbody>
          </table>
        </div>`;

      // Pagination
      const totalPages = Math.ceil(totalCount / PAGE_SIZE);
      pagEl.style.display = totalPages > 1 ? '' : 'none';
      pagEl.innerHTML = `
        <span>${totalCount.toLocaleString()} product${totalCount === 1 ? '' : 's'}</span>
        <span style="flex:1"></span>
        <button class="a-btn a-btn-sm" data-page="prev" ${currentPage === 0 ? 'disabled' : ''}>&laquo; Previous</button>
        <span style="font-size:0.82rem;">Page ${currentPage + 1} of ${totalPages}</span>
        <button class="a-btn a-btn-sm" data-page="next" ${currentPage + 1 >= totalPages ? 'disabled' : ''}>Next &raquo;</button>`;

      pagEl.querySelector('[data-page="prev"]')?.addEventListener('click', () => { currentPage--; load(); });
      pagEl.querySelector('[data-page="next"]')?.addEventListener('click', () => { currentPage++; load(); });

      // Delete handlers
      listEl.querySelectorAll<HTMLButtonElement>('[data-delete-id]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.deleteId!;
          const ok = await confirmDialog('Delete product?', 'This cannot be undone. Product images will remain in storage until manually deleted.');
          if (!ok) return;
          // Delete product images first
          const { error: delImgErr } = await supabase.from('product_images').delete().eq('product_id', id);
          const { error: delSpecErr } = await supabase.from('product_specifications').delete().eq('product_id', id);
          const { error: delProdErr } = await supabase.from('products').delete().eq('id', id);
          const err = delImgErr || delSpecErr || delProdErr;
          if (err) { toast(err.message, 'error'); return; }
          toast('Product deleted.', 'success');
          await load();
        });
      });
    }

    searchEl?.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => { currentPage = 0; load(); }, 280);
    });
    catEl?.addEventListener('change', () => { currentPage = 0; load(); });
    statusEl?.addEventListener('change', () => { currentPage = 0; load(); });

    void (async () => {
      if (!(await gate())) return;

      const { data: cats } = await supabase
        .from('categories')
        .select('id, name')
        .eq('is_active', true)
        .order('display_order');

      if (cats?.length) {
        catEl.innerHTML = `<option value="">All Categories</option>` +
          cats.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
      }
      await load();
    })();
  </script>
</AdminLayout>