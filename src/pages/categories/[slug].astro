---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { path, SITE_URL } from '../../lib/site';
import { CONTACT } from '../../lib/contact';
import { getCatalogueData, resolveImageUrl, resolveFirstImage, variantSlug } from '../../lib/db';

// Build the list of category pages (from Supabase, or the static fallback).
export async function getStaticPaths() {
  const catalogue = await getCatalogueData();
  return catalogue.categories.map(cat => ({
    params: { slug: cat.slug }
  }));
}

const catalogue = await getCatalogueData();
const category = catalogue.categories.find(c => c.slug === Astro.params.slug) ?? null;

if (!category) {
  return Astro.redirect('/products');
}

const products = category.sub_categories;
const totalSizes = category.variants_count;
const categorySizes = category.variants;

const variantCols = (['name', 'size', 'color', 'weight', 'capacity', 'material'] as const)
  .filter(k => categorySizes.some(v => v[k] !== null && v[k] !== ''));
const variantLabels: Record<string, string> = {
  name: 'Model',
  size: 'Size (L × W × H)',
  color: 'Colour',
  weight: 'Weight',
  capacity: 'Capacity / Load',
  material: 'Material'
};

const colors = Array.from(new Set(categorySizes.map(v => (v.color || '').trim()).filter(Boolean)));

// Known CSS colours used to render colour swatches on size cards.
const HEX_MAP: Record<string, string> = {
  blue: '#2563eb', green: '#16a34a', red: '#dc2626', yellow: '#eab308',
  white: '#f8fafc', black: '#111827', grey: '#6b7280', gray: '#6b7280',
  orange: '#ea580c', brown: '#92400e', pink: '#ec4899', purple: '#7c3aed'
};
function colorHex(color: string | null): string | null {
  if (!color) return null;
  return HEX_MAP[color.trim().toLowerCase()] || null;
}

// Model catalogue data for the combined sizes & models spec sheet:
// every variant gets its own resolved image, link and blueprint figure number.
const modelImages = new Map(
  (category.images || [])
    .filter(i => i.category_variant_id && i.image_url)
    .map(i => [i.category_variant_id, i.image_url])
);
const visualOf = (catVariant) => resolveFirstImage(modelImages.get(catVariant.id), category.image_url);
const hrefOf = (catVariant) => path(`/categories/${category.slug}/variant/${variantSlug(catVariant.name || catVariant.size || 'size')}`);

const catalogueModels = categorySizes.map((catVariant, i) => {
  const img = visualOf(catVariant);
  const hex = (catVariant.color || '').trim();
  return {
    v: catVariant,
    img,
    name: catVariant.name || catVariant.size || 'Model',
    href: hrefOf(catVariant),
    hex,
    hexCss: colorHex(hex) || '',
    fig: `FIG/${String(i + 1).padStart(2, '0')}`
  };
});

const heroImage = resolveImageUrl(category.image_url);
const pageTitle = `${category.name} | Vinayak Plastics`;
const pageDescription = `${category.description || `Explore our range of ${category.name.toLowerCase()}.`} View sizes, colours and available product types.`;

const categorySchema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "${SITE_URL}${path('/')}" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "${SITE_URL}${path('/products')}" },
    { "@type": "ListItem", "position": 3, "name": ${JSON.stringify(category.name)}, "item": "${SITE_URL}${path(`/categories/${category.slug}`)}" }
  ]
}`;

function sizeCountLabel(count: number): string {
  return `${count} ${count === 1 ? 'Size / Model' : 'Sizes / Models'}`;
}
---

<Layout title={pageTitle} description={pageDescription} structuredData={categorySchema}>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href={path('/')}>Home</a> / <a href={path('/products')}>Products</a> / {category.name}</p>
      <h1 class="display-800">{category.name}</h1>
      <p>{category.description}</p>
    </div>
  </section>

  <!-- ===== RANGE DETAIL ===== -->
  <section class="section" id="range-detail">
    <div class="container">
      <div class="cat-detail">
        <div class="cat-detail__media reveal">
          {heroImage ? (
            <img
              src={heroImage}
              alt={`${category.name} — Vinayak Plastics product range`}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="cat-detail__placeholder">{category.name}</span>
          )}
        </div>
        <div class="cat-detail__body reveal">
          <span class="sec-index">Product Range</span>
          <h2 class="display-700">{category.name}</h2>
          <p>{category.description || `We supply this product range in multiple sizes and colours to suit your application.`}</p>
          <div class="cat-detail__stats">
            <div class="cat-detail__stat">
              <strong>{products.length}</strong>
              <span>{products.length === 1 ? 'Product' : 'Products'}</span>
            </div>
            <div class="cat-detail__stat">
              <strong>{totalSizes}</strong>
              <span>{sizeCountLabel(totalSizes)}</span>
            </div>
          </div>
          {colors.length > 0 && (
            <div class="cat-detail__types">
              <span class="cat-detail__types-label">Colours available:</span>
              {colors.map(color => (
                <span class="cat-detail__chip">{color}</span>
              ))}
            </div>
          )}
          {categorySizes.length > 0 && (
            <div class="cat-detail__types">
              <span class="cat-detail__types-label">Models:</span>
              {categorySizes.slice(0, 6).map(v => (
                <a href={path(`/categories/${category.slug}/variant/${variantSlug(v.name || v.size || 'size')}`)} class="cat-detail__chip">{v.name || v.size}</a>
              ))}
              {categorySizes.length > 6 && <span class="cat-detail__types-label">+{categorySizes.length - 6} more</span>}
            </div>
          )}
          <a href={path('/contact')} class="btn btn-primary">Request Pricing &amp; Specs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MODEL CATALOGUE: SIZES, MODELS & SPECS ===== -->
  {catalogueModels.length > 0 && (
  <section class="section-warm" id="range">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Model Catalogue</p>
        <h2 class="display-700">Available sizes &amp; models</h2>
        <p>Click any model image to view it enlarged — or click a model name to open its full detail page.</p>
      </div>

      <div class="specs-table-wrap reveal">
        <table class="specs-table spec-table-models">
          <thead>
            <tr>
              {variantCols.map(k => (
                <th>{variantLabels[k]}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {catalogueModels.map(m => (
              <tr class="spec-row" data-spec-href={m.href}>
                {variantCols.map(k => (
                  <td class={k === 'name' ? 'spec-td-model' : ''}>
                    {k === 'name' ? (
                      <div class="spec-model">
                        {m.img && (
                          <button type="button" class="spec-model__thumb-btn"
                            data-lightbox-src={m.img}
                            data-lightbox-name={m.name}
                            data-lightbox-fig={m.fig}
                            aria-label={`Preview ${m.name} image`}>
                            <img class="spec-model__thumb" src={m.img} alt="" width="108" height="84" loading="lazy" decoding="async" />
                          </button>
                        )}
                        <a href={m.href} class="specs-model spec-model__link">{m.v[k] || '—'}</a>
                      </div>
                    ) : k === 'color' ? (
                      <span class="spec-swatch" style={`--chip:${m.hexCss || '#cccccc'}`}>{m.v[k] || '—'}</span>
                    ) : (
                      m.v[k] || '—'
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="lightbox" role="dialog" aria-modal="true" aria-label="Model image preview">
        <div class="lightbox__backdrop" data-lightbox-close></div>
        <figure class="lightbox__panel">
          <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close preview">&times;</button>
          <div class="lightbox__imgwrap">
            <img id="lightbox-img" src="" alt="" />
          </div>
          <figcaption class="lightbox__foot">
            <span class="lightbox__fig" id="lightbox-fig">FIG/01</span>
            <span class="lightbox__name" id="lightbox-name"></span>
          </figcaption>
        </figure>
      </div>

      <div class="reveal" style="margin-top:16px;font-size:0.85rem;color:var(--steel);text-align:center">
        <p>Note: Specifications are indicative. Final dimensions and weight may vary by batch. Contact us for detailed technical drawings.</p>
      </div>
    </div>
  </section>
  )}

  <!-- ===== PRODUCTS IN THIS RANGE ===== -->
  <section class="section section-warm" id="products">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Products in this range</p>
        <h2 class="display-700">Browse {category.name} products</h2>
        <p>Specific product types within the {category.name.toLowerCase()} family — choose one to see full specifications.</p>
      </div>

      {products.length > 0 ? (
        <div class="sc-grid">
          {products.map(sub => (
            <a href={path(`/categories/${sub.category_slug}/${sub.slug}`)} class="sc-card reveal">
              <div class="sc-card__img">
                {resolveFirstImage(sub.image_url, sub.images[0]?.image_url, category.image_url) ? (
                  <img
                    src={resolveFirstImage(sub.image_url, sub.images[0]?.image_url, category.image_url)!}
                    alt={`${sub.name}`}
                    width="480"
                    height="300"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="sc-card__placeholder">{sub.name}</span>
                )}
              </div>
              <div class="sc-card__body">
                <h3>{sub.name}</h3>
                {sub.short_description && <p>{sub.short_description}</p>}
                <div class="sc-card__meta">
                  <span class="sc-card__count">{sizeCountLabel(sub.variants_count)}</span>
                  <span class="sc-card__cta">View Details <span aria-hidden="true">→</span></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state reveal">
          <h3>Products in this range are coming soon</h3>
          <p>We are adding detailed breakdowns. <a href={path('/contact')}>Contact us</a> for the full range.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label={`Enquire about ${category.name.toLowerCase()}`}>
    <div class="container reveal">
      <h2 class="display-700">Need {category.name.toLowerCase()} specs or pricing?</h2>
      <p>Call or WhatsApp us directly for dimensions, material grades, custom sizes and dispatch timelines.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>

  <script is:inline>
    // Model catalogue lightbox: clicking a thumbnail in the spec sheet
    // opens the full-size model image in a modal. Pure progressive enhancement.
    (function () {
      var overlay = document.querySelector('.lightbox');
      if (!overlay) return;

      var imgEl = overlay.querySelector('#lightbox-img');
      var figEl = overlay.querySelector('#lightbox-fig');
      var nameEl = overlay.querySelector('#lightbox-name');
      var closeBtn = overlay.querySelector('.lightbox__close');
      var lastFocused = null;

      function open(src, name, fig) {
        lastFocused = document.activeElement;
        imgEl.src = src;
        imgEl.alt = name;
        if (nameEl) nameEl.textContent = name;
        if (figEl) figEl.textContent = fig;
        overlay.classList.add('lightbox--open');
        document.body.style.overflow = 'hidden';
        if (closeBtn) closeBtn.focus();
      }

      function close() {
        overlay.classList.remove('lightbox--open');
        document.body.style.overflow = '';
        if (lastFocused) lastFocused.focus();
      }

      document.querySelectorAll('[data-lightbox-src]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          open(
            btn.getAttribute('data-lightbox-src'),
            btn.getAttribute('data-lightbox-name') || 'Model',
            btn.getAttribute('data-lightbox-fig') || ''
          );
        });
      });

      overlay.addEventListener('click', function (e) {
        if (e.target.closest('[data-lightbox-close]')) close();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('lightbox--open')) close();
      });

      document.querySelectorAll('.spec-row[data-spec-href]').forEach(function (row) {
        row.addEventListener('click', function (e) {
          if (e.target.closest('a') || e.target.closest('button')) return;
          var href = row.getAttribute('data-spec-href');
          if (href) window.location.href = href;
        });
      });
    })();
  </script>

  <Footer />
</Layout>

<style>
  .cat-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 72px 0 96px;
  }

  .cat-detail__media {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--warm-off-white);
  }

  .cat-detail__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 24px;
  }

  .cat-detail__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    color: rgba(18, 42, 78, 0.3);
    background:
      linear-gradient(rgba(232, 99, 12, 0.04), rgba(232, 99, 12, 0.04)),
      var(--warm-off-white);
  }

  .cat-detail__body .sec-index {
    margin-bottom: 12px;
  }

  .cat-detail__body h2 {
    margin-bottom: 14px;
  }

  .cat-detail__body p {
    color: var(--steel);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .cat-detail__stats {
    display: flex;
    gap: 40px;
    border-top: 1px solid rgba(18, 42, 78, 0.08);
    border-bottom: 1px solid rgba(18, 42, 78, 0.08);
    padding: 20px 0;
    margin-bottom: 24px;
  }

  .cat-detail__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cat-detail__stat strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.8rem;
    color: var(--orange-deep);
    line-height: 1;
  }

  .cat-detail__stat span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .cat-detail__types {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .cat-detail__types-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .cat-detail__chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--deep-navy);
    background: rgba(18, 42, 78, 0.05);
    border: 1px solid rgba(18, 42, 78, 0.1);
    border-radius: 100px;
    padding: 6px 14px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  a.cat-detail__chip:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--white);
  }

  <!-- ===== MODEL CATALOGUE SPEC SHEET ===== -->
  .spec-table-models {
    min-width: 720px;
  }

  .spec-table-models th:first-child {
    min-width: 210px;
  }

  .spec-row {
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .spec-row:hover {
    background: rgba(232, 99, 12, 0.04);
  }

  .spec-model {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 190px;
  }

  .spec-model__thumb-btn {
    flex: 0 0 auto;
    width: 54px;
    height: 42px;
    padding: 0;
    border: none;
    background: none;
    border-radius: 4px;
    cursor: zoom-in;
    overflow: hidden;
  }

  .spec-model__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
    border-radius: 4px;
    background: var(--warm-off-white);
    border: 1px solid rgba(18, 42, 78, 0.1);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .spec-model__thumb-btn:hover .spec-model__thumb,
  .spec-model__thumb-btn:focus-visible .spec-model__thumb {
    border-color: var(--orange);
    transform: scale(1.08);
  }

  .specs-model {
    color: var(--orange-deep);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dashed rgba(232, 99, 12, 0.4);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .specs-model:hover {
    color: var(--orange);
    border-bottom-color: var(--orange);
  }

  .spec-swatch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .spec-swatch::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--chip, #ccc);
    border: 1px solid rgba(18, 42, 78, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  /* Simple image lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .lightbox--open {
    visibility: visible;
    opacity: 1;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 26, 51, 0.92);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .lightbox__panel {
    position: relative;
    z-index: 1;
    max-width: min(920px, 92vw);
    max-height: 88vh;
    margin: 0;
    background: var(--deep-navy);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .lightbox__imgwrap {
    padding: 20px;
  }

  .lightbox__imgwrap img {
    display: block;
    max-width: 100%;
    max-height: 62vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    background: var(--white);
    border-radius: var(--radius-sm);
  }

  .lightbox__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: var(--deep-navy);
    color: var(--white);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .lightbox__close:hover {
    background: var(--orange);
    border-color: var(--orange);
    transform: scale(1.08);
  }

  .lightbox__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px 16px;
    color: var(--white);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .lightbox__fig {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-light);
  }

  .lightbox__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>