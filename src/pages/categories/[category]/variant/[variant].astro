---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import BackButton from '../../../../components/BackButton.astro';
import { path } from '../../../../lib/site';
import { CONTACT } from '../../../../lib/contact';
import { getCategoryVariantPaths, getCategoryVariantBySlug, getCatalogueData, variantSlug, resolveImageUrl, resolveFirstImage } from '../../../../lib/db';

export async function getStaticPaths() {
  return await getCategoryVariantPaths();
}

const { category, variant } = Astro.params;
const size = await getCategoryVariantBySlug(category || '', variant || '');

if (!size) {
  return Astro.redirect('/products');
}

const catalogue = await getCatalogueData();
const parent = catalogue.categories.find(c => c.slug === size.category_slug) ?? null;
const relatedSizes = (parent?.variants || []).filter(v => v.id !== size.id);
const relatedProducts = (parent?.sub_categories || []).filter(s => s.is_active);

// Prev / next navigation within the same size range.
const variantOrder = parent?.variants || [];
const currentIndex = variantOrder.findIndex(v => v.id === size.id);
const prevVariant = currentIndex > 0 ? variantOrder[currentIndex - 1] : null;
const nextVariant = (currentIndex >= 0 && currentIndex < variantOrder.length - 1) ? variantOrder[currentIndex + 1] : null;
const backHref = path(`/categories/${size.category_slug}`);
const variantHref = (catVariant) => path(`/categories/${size.category_slug}/variant/${variantSlug(catVariant.name || catVariant.size || 'size')}`);

const sizeImages = size.images;
const mainImage = resolveFirstImage(...sizeImages.map(i => i.image_url), size.category_image_url);
const resolvableSizeImages = sizeImages.filter(i => resolveImageUrl(i.image_url));

// Known CSS colours used to render colour swatches.
const COLOR_HEX: Record<string, string> = {
  blue: '#2563eb', green: '#16a34a', red: '#dc2626', yellow: '#eab308',
  white: '#f8fafc', black: '#111827', grey: '#6b7280', gray: '#6b7280',
  orange: '#ea580c', brown: '#92400e', pink: '#ec4899', purple: '#7c3aed'
};

const specs = [
  { label: 'Model', value: size.name },
  { label: 'External Size (L × W × H)', value: size.size },
  { label: 'Shape / Version', value: size.shape },
  { label: 'Colour', value: size.color },
  { label: 'Weight', value: size.weight },
  { label: 'Capacity / Load', value: size.capacity },
  { label: 'Material', value: size.material },
  { label: 'Price / Band', value: size.price }
].filter(s => s.value);

const colorValues = size.color ? size.color.split(',').map(c => c.trim()).filter(Boolean) : [];

const familyApplications = Array.from(new Map(
  relatedProducts
    .flatMap(s => (s.applications || []).map(a => ({ name: a.name, description: a.description })))
    .map(a => [a.name, a])
).values()).filter(a => a.name);

const subtitle = size.category_description ?? 'Size / model in the Vinayak Plastics range.';
const pageTitle = `${size.name} | ${size.category_name} | Vinayak Plastics`;
const pageDescription = `${size.name} ${size.category_name.toLowerCase()} — ${[size.size, size.color, size.weight, size.capacity].filter(Boolean).join(' · ')}.`;

const schema = `{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": ${JSON.stringify(size.name)},
  "description": ${JSON.stringify(subtitle)},
  ${mainImage ? `"image": ${JSON.stringify(mainImage)},` : ''}
  "brand": { "@type": "Brand", "name": "Vinayak Plastics" },
  "category": ${JSON.stringify(size.category_name)},
  ${size.size ? `"size": ${JSON.stringify(size.size)},` : ''}
  ${size.color ? `"color": ${JSON.stringify(size.color)},` : ''}
  ${size.material ? `"material": ${JSON.stringify(size.material)}` : ''}
}`;
---

<Layout title={pageTitle} description={pageDescription} structuredData={schema}>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-top">
        <p class="breadcrumb">
          <a href={path('/')}>Home</a> / <a href={path('/products')}>Products</a> /
          <a href={backHref}>{size.category_name}</a> / {size.name}
        </p>
        <BackButton href={backHref} />
      </div>
      <h1 class="display-800">{size.name}</h1>
      <p>{size.size || size.category_name}</p>
    </div>
  </section>

  <!-- ===== SIZE DETAIL ===== -->
  <section class="section" id="size-detail">
    <div class="container">
      <div class="cat-detail">
        <div class="cat-detail__media reveal">
          {mainImage ? (
            <img
              class="pd-main-img"
              src={mainImage}
              alt={`${size.name} — ${size.category_name}`}
              width="800"
              height="600"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span class="cat-detail__placeholder">{size.name}</span>
          )}
          {resolvableSizeImages.length > 1 && (
            <div class="pd-thumbs" role="group" aria-label="Size images">
              {resolvableSizeImages.map((img, i) => (
                <button type="button" class:list={['pd-thumb', i === 0 && 'is-active']} data-src={resolveImageUrl(img.image_url)} aria-label={`View image ${i + 1}`}>
                  <img src={resolveImageUrl(img.image_url)!} alt={img.alt_text || `${size.name} image ${i + 1}`} width="120" height="90" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="cat-detail__body reveal">
          <span class="sec-index">{size.category_name} · Size / Model</span>
          <h2 class="display-700">{size.name}</h2>
          <p>{subtitle}</p>

          {colorValues.length > 0 && (
            <div class="cat-detail__types">
              <span class="cat-detail__types-label">Colours available:</span>
              {colorValues.map(c => {
                const hex = COLOR_HEX[c.trim().toLowerCase()] || null;
                return <span class="cat-detail__chip v-chip" style={hex ? `--chip:${hex}` : ''}>{c}</span>;
              })}
            </div>
          )}

          {specs.length > 0 && (
            <dl class="vd-specs">
              {specs.map(s => (
                <div class="vd-spec">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )}

          <div class="cat-detail__actions">
            <a href={path('/contact')} class="btn btn-primary">Request Pricing &amp; Specs</a>
            <BackButton variant="on-light" href={backHref} />
          </div>
        </div>
      </div>

      {(prevVariant || nextVariant) && (
        <nav class="vpager" aria-label="Other sizes in this range">
          {prevVariant ? (
            <a class="vpager__link vpager__link--prev" href={variantHref(prevVariant)}>
              <span aria-hidden="true">←</span> {prevVariant.name || prevVariant.size}
            </a>
          ) : (
            <span class="vpager__spacer" aria-hidden="true"></span>
          )}
          <span class="vpager__count">{currentIndex >= 0 ? `Size ${currentIndex + 1} of ${variantOrder.length}` : ''}</span>
          {nextVariant ? (
            <a class="vpager__link vpager__link--next" href={variantHref(nextVariant)}>
              {nextVariant.name || nextVariant.size} <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="vpager__spacer" aria-hidden="true"></span>
          )}
        </nav>
      )}

      <p class="vd-note reveal">
        Note: Specifications are indicative. Final dimensions and weight may vary by batch. Contact us for detailed technical drawings.
      </p>
    </div>
  </section>

  <!-- ===== APPLICATIONS ===== -->
  {familyApplications.length > 0 && (
  <section class="section" id="applications">
    <div class="container-sm">
      <div class="section-header reveal">
        <p class="sec-index">Applications</p>
        <h2 class="display-700">Common applications</h2>
        <p>Where {size.category_name.toLowerCase()} of this size are typically used.</p>
      </div>
      <div class="app-grid reveal">
        {familyApplications.map(app => (
          <div class="app-card">
            <h3>{app.name}</h3>
            <p>{app.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ===== OTHER SIZES IN RANGE ===== -->
  {relatedSizes.length > 0 && (
  <section class="section section-warm" id="related-sizes">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Range</p>
        <h2 class="display-700">Other sizes in this range</h2>
        <p>Explore every model in the {size.category_name.toLowerCase()} family.</p>
      </div>
      <div class="sc-grid reveal">
        {relatedSizes.map(v => {
          const vImage = parent?.images.find(i => i.category_variant_id === v.id);
          const img = resolveFirstImage(vImage?.image_url, size.category_image_url);
          const hex = (v.color || '').trim();
          const hexCss = COLOR_HEX[hex.toLowerCase()] || null;
          const chipStyle = hexCss ? `--chip:${hexCss}` : '';
          return (
            <a href={path(`/categories/${size.category_slug}/variant/${variantSlug(v.name || v.size || 'size')}`)} class="sc-card">
              <div class="sc-card__img">
                {img ? (
                  <img src={img} alt={`${v.name} — ${size.category_name}`} width="480" height="300" loading="lazy" decoding="async" />
                ) : (
                  <span class="sc-card__placeholder">{v.name}</span>
                )}
              </div>
              <div class="sc-card__body">
                <h3>{v.name || v.size}</h3>
                {v.size && <p>{v.size}</p>}
                <div class="sc-card__meta">
                  {hex ? (
                    <span class="v-color-chip" style={chipStyle}>{hex}</span>
                  ) : (
                    <span class="sc-card__count">{size.category_name}</span>
                  )}
                  <span class="sc-card__cta">View Size <span aria-hidden="true">→</span></span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
  )}

  <!-- ===== PRODUCTS IN THIS RANGE ===== -->
  {relatedProducts.length > 0 && (
  <section class="section" id="products">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Products</p>
        <h2 class="display-700">{size.category_name} product types</h2>
        <p>Related product types sharing this range.</p>
      </div>
      <div class="sc-grid reveal">
        {relatedProducts.map(sub => (
          <a href={path(`/categories/${sub.category_slug}/${sub.slug}`)} class="sc-card">
            <div class="sc-card__img">
              {resolveFirstImage(sub.image_url, sub.images[0]?.image_url, size.category_image_url) ? (
                <img src={resolveFirstImage(sub.image_url, sub.images[0]?.image_url, size.category_image_url)!} alt={sub.name} width="480" height="300" loading="lazy" decoding="async" />
              ) : (
                <span class="sc-card__placeholder">{sub.name}</span>
              )}
            </div>
            <div class="sc-card__body">
              <h3>{sub.name}</h3>
              {sub.short_description && <p>{sub.short_description}</p>}
              <div class="sc-card__meta">
                <span class="sc-card__count">{sub.variants_count} size{sub.variants_count === 1 ? '' : 's'}</span>
                <span class="sc-card__cta">View Details <span aria-hidden="true">→</span></span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label={`Enquire about ${size.name}`}>
    <div class="container reveal">
      <h2 class="display-700">Need {size.name} specs or pricing?</h2>
      <p>Call or WhatsApp us directly for dimensions, material grades, custom sizes and dispatch timelines.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
      <p class="cta-back">
        <BackButton href={backHref} />
      </p>
    </div>
  </section>

  </main>

  (mainImage && (
  <div class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged model image">
    <div class="lightbox__backdrop" data-lightbox-close></div>
    <figure class="lightbox__panel">
      <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close preview">&times;</button>
      <div class="lightbox__imgwrap">
        <img id="lightbox-img" src="" alt="" />
      </div>
      <figcaption class="lightbox__foot">
        <span class="lightbox__fig">{size.category_name} · Size / Model</span>
        <span class="lightbox__name">{size.name}</span>
      </figcaption>
    </figure>
  </div>
  ))
  <Footer />
</Layout>

<style>
  .vd-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border: 1px solid rgba(18, 42, 78, 0.08);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 24px;
    background: var(--white);
  }
  .vd-spec {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(18, 42, 78, 0.06);
  }
  .vd-spec:nth-child(n+3) { border-bottom: none; }
  .vd-spec dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 4px;
  }
  .vd-spec dd {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--deep-navy);
  }

  /* ===== SIZE DETAIL LAYOUT ===== */
  .cat-detail {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: start;
    padding: 32px 0 40px;
  }

  .cat-detail__media {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--warm-off-white);
  }

  .cat-detail__media img.pd-main-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    object-position: center;
    padding: 24px;
    cursor: zoom-in;
    transition: transform 0.2s ease;
  }

  .cat-detail__media img.pd-main-img:hover {
    transform: scale(1.015);
  }

  .cat-detail__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4/3;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    color: rgba(18, 42, 78, 0.3);
    background: var(--warm-off-white);
  }

  .cat-detail__body .sec-index { margin-bottom: 12px; }
  .cat-detail__body h2 { margin-bottom: 14px; }
  .cat-detail__body > p { color: var(--steel); line-height: 1.7; margin-bottom: 20px; }

  .cat-detail__types {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
  }

  .cat-detail__types-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .cat-detail__chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--deep-navy);
    background: rgba(18, 42, 78, 0.05);
    border: 1px solid rgba(18, 42, 78, 0.1);
    border-radius: 100px;
    padding: 6px 14px;
  }

  .cat-detail__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  /* ===== BACK BUTTON (shared component) ===== */
  .cta-back {
    margin-top: 26px;
    text-align: center;
  }

  .cat-detail__actions .back-btn {
    align-self: center;
  }

  /* ===== PREV / NEXT SIZE PAGER ===== */
  .vpager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
    padding-top: 28px;
    border-top: 1px solid rgba(18, 42, 78, 0.08);
  }

  .vpager__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--deep-navy);
    text-decoration: none;
    background: var(--white);
    border: 1px solid rgba(18, 42, 78, 0.12);
    border-radius: 100px;
    padding: 9px 18px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .vpager__link--prev { justify-self: start; }
  .vpager__link--next { justify-self: end; }
  .vpager__link:hover { border-color: var(--orange); color: var(--orange-deep); }
  .vpager__link--prev:hover { transform: translateX(-2px); }
  .vpager__link--next:hover { transform: translateX(2px); }

  .vpager__count {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--steel);
    white-space: nowrap;
  }

  .vpager__spacer { width: 60px; }

  .vd-note {
    margin-top: 18px;
    font-size: 0.85rem;
    color: var(--steel);
    text-align: center;
  }

  .pd-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }
  .pd-thumb {
    width: 84px;
    height: 64px;
    padding: 0;
    border: 2px solid rgba(18, 42, 78, 0.1);
    border-radius: var(--radius-sm);
    background: var(--warm-off-white);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .pd-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6px;
  }
  .pd-thumb:hover { transform: translateY(-2px); }
  .pd-thumb.is-active { border-color: var(--orange); }

  .v-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .v-chip::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--chip, #ccc);
    border: 1px solid rgba(18, 42, 78, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .v-color-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
    background: rgba(18, 42, 78, 0.04);
    padding: 5px 10px;
    border-radius: 2px;
  }
  .v-color-chip::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--chip, #ccc);
    border: 1px solid rgba(18, 42, 78, 0.18);
  }

  /* ===== IMAGE LIGHTBOX ===== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .lightbox--open {
    visibility: visible;
    opacity: 1;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 26, 51, 0.92);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .lightbox__panel {
    position: relative;
    z-index: 1;
    max-width: min(920px, 92vw);
    max-height: 88vh;
    margin: 0;
    background: var(--deep-navy);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .lightbox__imgwrap {
    padding: 20px;
  }

  .lightbox__imgwrap img {
    display: block;
    max-width: 100%;
    max-height: 62vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    background: var(--white);
    border-radius: var(--radius-sm);
  }

  .lightbox__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: var(--deep-navy);
    color: var(--white);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .lightbox__close:hover {
    background: var(--orange);
    border-color: var(--orange);
    transform: scale(1.08);
  }

  .lightbox__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px 16px;
    color: var(--white);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .lightbox__fig {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-light);
  }

  .lightbox__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  @media (max-width: 960px) {
    .cat-detail {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .cat-detail__media {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .vd-specs { grid-template-columns: 1fr; }
    .vd-spec:nth-child(n+3) { border-bottom: 1px solid rgba(18, 42, 78, 0.06); }
    .vd-spec:last-child { border-bottom: none; }

    .vpager {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .vpager__link { font-size: 0.68rem; padding: 8px 12px; }
    .vpager__count { grid-column: 1 / -1; justify-self: center; order: -1; }
  }

  @media (max-width: 480px) {
    /* Product-range section — mobile only, desktop untouched */
    .cat-detail { gap: 26px; padding: 18px 0 28px; }

    .cat-detail__media img.pd-main-img { padding: 12px; }

    .cat-detail__body { padding: 0 3px; }

    .cat-detail__types { gap: 11px; }
    .cat-detail__types-label { flex-basis: 100%; margin-bottom: 16px; }

    .vd-spec dd { font-size: 0.84rem; }

    .cat-detail__actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .cat-detail__actions .btn {
      width: 100%;
      justify-content: center;
    }

    .pd-thumbs { gap: 8px; }
    .pd-thumb { width: 70px; height: 54px; }
  }
</style>

<script is:inline>
(function () {
  // Main image thumbnail switcher
  var main = document.querySelector('.cat-detail__media img');
  if (!main) return;
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('.pd-thumb'));
  thumbs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var src = btn.getAttribute('data-src');
      if (src) main.setAttribute('src', src);
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });
})();

(function () {
  // Click main image to open enlarged lightbox
  var overlay = document.querySelector('.lightbox');
  var main = document.querySelector('.pd-main-img');
  if (!overlay || !main) return;

  var imgEl = overlay.querySelector('#lightbox-img');
  var closeBtn = overlay.querySelector('.lightbox__close');
  var lastFocused = null;

  function open(src) {
    lastFocused = document.activeElement;
    imgEl.src = src;
    imgEl.alt = main.alt || '';
    overlay.classList.add('lightbox--open');
    document.body.style.overflow = 'hidden';
    if (closeBtn) closeBtn.focus();
  }

  function close() {
    overlay.classList.remove('lightbox--open');
    document.body.style.overflow = '';
    if (lastFocused) lastFocused.focus();
  }

  main.addEventListener('click', function () { open(main.getAttribute('src')); });

  overlay.addEventListener('click', function (e) {
    if (e.target.closest('[data-lightbox-close]')) close();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('lightbox--open')) close();
  });
})();
</script>