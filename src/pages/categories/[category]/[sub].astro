---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BackButton from '../../../components/BackButton.astro';
import { path, SITE_URL } from '../../../lib/site';
import { CONTACT } from '../../../lib/contact';
import {
  getSubCategoryPaths, getCatalogueData, resolveFirstImage, variantSlug
} from '../../../lib/db';

export async function getStaticPaths() {
  return await getSubCategoryPaths();
}

const { category, sub } = Astro.params;
const catalogue = await getCatalogueData();
const subCategory = catalogue.subCategories.find(s => s.slug === sub && s.category_slug === category) ?? null;

if (!subCategory) {
  return Astro.redirect('/products');
}

const categoryData = catalogue.categories.find(c => c.slug === category) ?? null;
const siblingProducts = (categoryData?.sub_categories ?? []).filter(s => s.slug !== subCategory.slug);
const categoryVariantNames = new Set((categoryData?.variants ?? []).map(v => (v.name || '').trim()).filter(Boolean));
const linkableVariants = subCategory.variants.filter(v => categoryVariantNames.has((v.name || '').trim()));

const variants = subCategory.variants;
const hasVariants = variants.length > 0;
const variantCols = (['name', 'size', 'shape', 'color', 'weight', 'capacity', 'material'] as const)
  .filter(k => hasVariants && variants.some(v => v[k] !== null && v[k] !== ''));
const variantLabels: Record<string, string> = {
  name: 'Model',
  size: 'Size (L × W × H)',
  shape: 'Shape',
  color: 'Colour',
  weight: 'Weight',
  capacity: 'Capacity / Load',
  material: 'Material'
};

// Specifications are kept as a fallback table for ranges that have no explicit variants.
const specificationModels = (subCategory.specifications || []).reduce((acc, spec) => {
  const existing = acc.find(s => s.model === spec.specification_name);
  if (existing) {
    existing[spec.specification_name.toLowerCase()] = spec.specification_value;
  } else {
    acc.push({ model: spec.specification_name, [spec.specification_name.toLowerCase()]: spec.specification_value });
  }
  return acc;
}, [] as Array<Record<string, string>>);

const features = subCategory.features || [];
const applications = (subCategory.applications || []).filter(a => a.name);
const gallery = subCategory.images.length > 0
  ? subCategory.images
  : subCategory.image_url
    ? [{ id: 'main', sub_category_id: subCategory.id, sub_category_variant_id: null, image_url: subCategory.image_url, alt_text: null, display_order: 0 }]
    : [];
const mainImage = resolveFirstImage(subCategory.image_url, ...gallery.map(g => g.image_url));

const colors = Array.from(new Set(variants.map(v => (v.color || '').trim()).filter(Boolean)));

// Known CSS colours used to render colour swatches on size cards.
const HEX_MAP: Record<string, string> = {
  blue: '#2563eb', green: '#16a34a', red: '#dc2626', yellow: '#eab308',
  white: '#f8fafc', black: '#111827', grey: '#6b7280', gray: '#6b7280',
  orange: '#ea580c', brown: '#92400e', pink: '#ec4899', purple: '#7c3aed'
};
function colorHex(color: string | null): string | null {
  if (!color) return null;
  return HEX_MAP[color.trim().toLowerCase()] || null;
}

// Model catalogue data for the combined sizes & models spec sheet:
// every variant gets its own resolved image, link and blueprint figure number.
const modelImages = new Map(
  (subCategory.images || [])
    .filter(i => i.sub_category_variant_id && i.image_url)
    .map(i => [i.sub_category_variant_id, i.image_url])
);
const catalogueModels = variants.map((v, i) => {
  const img = resolveFirstImage(modelImages.get(v.id), mainImage);
  const isLinkable = categoryVariantNames.has((v.name || '').trim());
  const hex = (v.color || '').trim();
  return {
    v,
    img,
    name: v.name || v.size || 'Model',
    href: isLinkable
      ? path(`/categories/${subCategory.category_slug}/variant/${variantSlug(v.name || v.size || 'size')}`)
      : path('/contact'),
    hex,
    hexCss: colorHex(hex) || '',
    fig: `FIG/${String(i + 1).padStart(2, '0')}`
  };
});

function sizeCountLabel(count: number): string {
  return `${count} ${count === 1 ? 'Size / Model' : 'Sizes / Models'}`;
}

const statCards = [
  {
    value: String(hasVariants ? variants.length : specificationModels.length),
    label: sizeCountLabel(hasVariants ? variants.length : specificationModels.length)
  },
  ...(applications.length > 0
    ? [{ value: String(applications.length), label: applications.length === 1 ? 'Application' : 'Applications' }]
    : [])
];

const subtitle = subCategory.short_description || subCategory.description || subCategory.name;
const pageTitle = `${subCategory.name} | Vinayak Plastics`;
const pageDescription = `${(subCategory.description || subCategory.short_description || `Explore our ${subCategory.name} range.`).slice(0, 150)}`;

const productSchema = `{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "${subCategory.name}",
  "description": ${JSON.stringify(subCategory.description || subtitle)},
  "image": "${SITE_URL}${path('/images/vp-logo.png')}",
  "brand": { "@type": "Brand", "name": "Vinayak Plastics" },
  "category": "Material Handling Equipment"
}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  structuredData={productSchema}
>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-top">
        <p class="breadcrumb"><a href={path('/')}>Home</a> / <a href={path('/products')}>Products</a> / <a href={path(`/categories/${subCategory.category_slug}`)}>{subCategory.category_name}</a> / {subCategory.name}</p>
        <BackButton href={path(`/categories/${subCategory.category_slug}`)} />
      </div>
      <h1 class="display-800">{subCategory.name}</h1>
      <p>{subtitle}</p>
    </div>
  </section>

  <!-- ===== PRODUCT DETAIL ===== -->
  <section class="section" id="range-detail">
    <div class="container">
      <div class="cat-detail">
        <div class="cat-detail__media-wrap reveal">
          <div class="cat-detail__media">
            {mainImage ? (
              <img
                src={mainImage}
                alt={`${subCategory.name} — ${subCategory.category_name}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="cat-detail__placeholder">{subCategory.name}</span>
            )}
          </div>
        </div>
        <div class="cat-detail__body reveal">
          <span class="sec-index">Product · {subCategory.category_name}</span>
          <h2 class="display-700">{subCategory.name}</h2>
          <p>{subCategory.description}</p>
          {statCards.length > 0 && (
            <div class="cat-detail__stats">
              {statCards.map(stat => (
                <div class="cat-detail__stat">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))}
            </div>
          )}
          {colors.length > 0 && (
            <div class="cat-detail__types">
              <span class="cat-detail__types-label">Colours available:</span>
              {colors.map(color => (
                <span class="cat-detail__chip">{color}</span>
              ))}
            </div>
          )}
          {linkableVariants.length > 0 && (
            <div class="cat-detail__types">
              <span class="cat-detail__types-label">Models:</span>
              {linkableVariants.slice(0, 6).map(v => (
                <a href={path(`/categories/${subCategory.category_slug}/variant/${variantSlug(v.name || v.size || 'size')}`)} class="cat-detail__chip">{v.name || v.size}</a>
              ))}
              {linkableVariants.length > 6 && <span class="cat-detail__types-label">+{linkableVariants.length - 6} more</span>}
            </div>
          )}
          {
            subCategory.product_code && (
              <p style="font-family:var(--font-mono);font-size:0.8rem;color:var(--steel);">
                Series code: <strong>{subCategory.product_code}</strong>
              </p>
            )
          }
          <a href={path('/contact')} class="btn btn-primary">Request Pricing &amp; Specs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MODEL CATALOGUE: SIZES, MODELS & SPECS ===== -->
  {(hasVariants || specificationModels.length > 0) && (
  <section class="section-warm" id="range">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Model Catalogue</p>
        <h2 class="display-700">Available sizes &amp; models</h2>
        <p>Click any model image to view it enlarged — or click a model name to open its full detail page.</p>
      </div>

      {hasVariants ? (
        <div class="specs-table-wrap reveal">
          <table class="specs-table spec-table-models">
            <thead>
              <tr>
                {variantCols.map(k => (
                  <th>{variantLabels[k]}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {catalogueModels.map(m => (
                <tr class="spec-row" data-spec-href={m.href}>
                  {variantCols.map(k => (
                    <td class={k === 'name' ? 'spec-td-model' : ''}>
                      {k === 'name' ? (
                        <div class="spec-model">
                          {m.img && (
                            <button type="button" class="spec-model__thumb-btn"
                              data-lightbox-src={m.img}
                              data-lightbox-name={m.name}
                              data-lightbox-fig={m.fig}
                              aria-label={`Preview ${m.name} image`}>
                              <img class="spec-model__thumb" src={m.img} alt="" width="108" height="84" loading="lazy" decoding="async" />
                            </button>
                          )}
                          <a href={m.href} class="specs-model spec-model__link">{m.v[k] || '—'}</a>
                        </div>
                      ) : k === 'color' ? (
                        <span class="spec-swatch" style={`--chip:${m.hexCss || '#cccccc'}`}>{m.v[k] || '—'}</span>
                      ) : (
                        m.v[k] || '—'
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="specs-table-wrap reveal">
          <table class="specs-table">
            <thead>
              <tr>
                <th>Model</th>
                <th>External Size (L × W × H) mm</th>
                <th>Weight</th>
                <th>Load Capacity</th>
                <th>Material</th>
              </tr>
            </thead>
            <tbody>
              {specificationModels.map(spec => (
                <tr>
                  <td>{spec.model}</td>
                  <td>{spec.size}</td>
                  <td>{spec.weight}</td>
                  <td>{spec.capacity}</td>
                  <td>{spec.material}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {hasVariants && (
      <div class="lightbox" role="dialog" aria-modal="true" aria-label="Model image preview">
        <div class="lightbox__backdrop" data-lightbox-close></div>
        <figure class="lightbox__panel">
          <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close preview">&times;</button>
          <div class="lightbox__imgwrap">
            <img id="lightbox-img" src="" alt="" />
          </div>
          <figcaption class="lightbox__foot">
            <span class="lightbox__fig" id="lightbox-fig">FIG/01</span>
            <span class="lightbox__name" id="lightbox-name"></span>
          </figcaption>
        </figure>
      </div>
      )}

      <div class="reveal" style="margin-top:16px;font-size:0.85rem;color:var(--steel);text-align:center">
        <p>Note: Specifications are indicative. Final dimensions and weight may vary by batch. Contact us for detailed technical drawings.</p>
      </div>
    </div>
  </section>
  )}

  <!-- ===== FEATURES & APPLICATIONS ===== -->
  {(features.length > 0 || applications.length > 0) && (
  <section class="section-warm" id="features">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">Features &amp; Applications</p>
        <h2 class="display-700">Why choose {subCategory.name}</h2>
        <p>Key product features and the sectors where {subCategory.name.toLowerCase()} is used every day.</p>
      </div>
      <div class="feat-app">
        {features.length > 0 && (
          <ul class="pd-features reveal">
            {features.map(feature => (
              <li>{feature}</li>
            ))}
          </ul>
        )}
        {applications.length > 0 && (
          <div class="app-grid reveal">
            {applications.map(app => (
              <div class="app-card">
                <h3>{app.name}</h3>
                <p>{app.description}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
  )}

  <!-- ===== MORE IN THIS RANGE ===== -->
  <section class="section section-warm" id="products">
    <div class="container">
      <div class="section-header reveal">
        <p class="sec-index">More from this range</p>
        <h2 class="display-700">More {subCategory.category_name} products</h2>
        <p>Specific product types within the {subCategory.category_name.toLowerCase()} family — choose one to see full specifications.</p>
      </div>
      {siblingProducts.length > 0 ? (
        <div class="sc-grid reveal">
          {siblingProducts.map(p => (
            <a href={path(`/categories/${p.category_slug}/${p.slug}`)} class="sc-card reveal">
              <div class="sc-card__img">
                {resolveFirstImage(p.image_url, p.images[0]?.image_url, categoryData?.image_url) ? (
                  <img
                    src={resolveFirstImage(p.image_url, p.images[0]?.image_url, categoryData?.image_url)!}
                    alt={p.name}
                    width="480"
                    height="300"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="sc-card__placeholder">{p.name}</span>
                )}
              </div>
              <div class="sc-card__body">
                <h3>{p.name}</h3>
                {p.short_description && <p>{p.short_description}</p>}
                <div class="sc-card__meta">
                  <span class="sc-card__count">{sizeCountLabel(p.variants_count)}</span>
                  <span class="sc-card__cta">View Details <span aria-hidden="true">→</span></span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state reveal">
          <h3>More {subCategory.category_name.toLowerCase()} products are coming soon</h3>
          <p>We are adding detailed product breakdowns. <a href={path('/contact')}>Contact us</a> for the full {subCategory.category_name.toLowerCase()} range.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label={`Enquire about ${subCategory.name.toLowerCase()}`}>
    <div class="container reveal">
      <h2 class="display-700">Need {subCategory.name.toLowerCase()} specs or pricing?</h2>
      <p>We supply {subCategory.category_name.toLowerCase()} to businesses across India. Call or WhatsApp for a quote.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>

  <script is:inline>
    // Model catalogue lightbox: clicking a thumbnail in the spec sheet
    // opens the full-size model image in a modal. Pure progressive enhancement.
    (function () {
      var overlay = document.querySelector('.lightbox');
      if (!overlay) return;

      var imgEl = overlay.querySelector('#lightbox-img');
      var figEl = overlay.querySelector('#lightbox-fig');
      var nameEl = overlay.querySelector('#lightbox-name');
      var closeBtn = overlay.querySelector('.lightbox__close');
      var lastFocused = null;

      function open(src, name, fig) {
        lastFocused = document.activeElement;
        imgEl.src = src;
        imgEl.alt = name;
        if (nameEl) nameEl.textContent = name;
        if (figEl) figEl.textContent = fig;
        overlay.classList.add('lightbox--open');
        document.body.style.overflow = 'hidden';
        if (closeBtn) closeBtn.focus();
      }

      function close() {
        overlay.classList.remove('lightbox--open');
        document.body.style.overflow = '';
        if (lastFocused) lastFocused.focus();
      }

      document.querySelectorAll('[data-lightbox-src]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          open(
            btn.getAttribute('data-lightbox-src'),
            btn.getAttribute('data-lightbox-name') || 'Model',
            btn.getAttribute('data-lightbox-fig') || ''
          );
        });
      });

      overlay.addEventListener('click', function (e) {
        if (e.target.closest('[data-lightbox-close]')) close();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('lightbox--open')) close();
      });

      document.querySelectorAll('.spec-row[data-spec-href]').forEach(function (row) {
        row.addEventListener('click', function (e) {
          if (e.target.closest('a') || e.target.closest('button')) return;
          var href = row.getAttribute('data-spec-href');
          if (href) window.location.href = href;
        });
      });
    })();
  </script>

  <Footer />
</Layout>

<style>
  .cat-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 72px 0 96px;
  }

  .cat-detail__media-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cat-detail__media {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--warm-off-white);
  }

  .cat-detail__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 24px;
  }

  .cat-detail__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    color: rgba(18, 42, 78, 0.3);
    background:
      linear-gradient(rgba(232, 99, 12, 0.04), rgba(232, 99, 12, 0.04)),
      var(--warm-off-white);
  }

  .cat-detail__body .sec-index {
    margin-bottom: 12px;
  }

  .cat-detail__body h2 {
    margin-bottom: 14px;
  }

  .cat-detail__body p {
    color: var(--steel);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .cat-detail__stats {
    display: flex;
    gap: 40px;
    border-top: 1px solid rgba(18, 42, 78, 0.08);
    border-bottom: 1px solid rgba(18, 42, 78, 0.08);
    padding: 20px 0;
    margin-bottom: 24px;
  }

  .cat-detail__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cat-detail__stat strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.8rem;
    color: var(--orange-deep);
    line-height: 1;
  }

  .cat-detail__stat span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .cat-detail__types {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .cat-detail__types-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .cat-detail__chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--deep-navy);
    background: rgba(18, 42, 78, 0.05);
    border: 1px solid rgba(18, 42, 78, 0.1);
    border-radius: 100px;
    padding: 6px 14px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  a.cat-detail__chip:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--white);
  }

  .pd-features {
    list-style: none;
    display: grid;
    gap: 8px;
    margin: 0 0 20px;
  }

  .feat-app {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .feat-app {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .pd-features li {
    position: relative;
    padding-left: 20px;
    color: var(--deep-navy);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .pd-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--orange);
  }

  <!-- ===== MODEL CATALOGUE SPEC SHEET ===== -->
  .spec-table-models {
    min-width: 720px;
  }

  .spec-table-models th:first-child {
    min-width: 210px;
  }

  .spec-row {
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .spec-row:hover {
    background: rgba(232, 99, 12, 0.04);
  }

  .spec-model {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 190px;
  }

  .spec-model__thumb-btn {
    flex: 0 0 auto;
    width: 54px;
    height: 42px;
    padding: 0;
    border: none;
    background: none;
    border-radius: 4px;
    cursor: zoom-in;
    overflow: hidden;
  }

  .spec-model__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
    border-radius: 4px;
    background: var(--warm-off-white);
    border: 1px solid rgba(18, 42, 78, 0.1);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .spec-model__thumb-btn:hover .spec-model__thumb,
  .spec-model__thumb-btn:focus-visible .spec-model__thumb {
    border-color: var(--orange);
    transform: scale(1.08);
  }

  .specs-model {
    color: var(--orange-deep);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dashed rgba(232, 99, 12, 0.4);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .specs-model:hover {
    color: var(--orange);
    border-bottom-color: var(--orange);
  }

  .spec-swatch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .spec-swatch::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--chip, #ccc);
    border: 1px solid rgba(18, 42, 78, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  /* Simple image lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .lightbox--open {
    visibility: visible;
    opacity: 1;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
