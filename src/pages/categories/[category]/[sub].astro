---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { path, SITE_URL } from '../../../lib/site';
import { CONTACT } from '../../../lib/contact';
import { getSubCategoryPaths, getSubCategoryBySlug, resolveImageUrl } from '../../../lib/db';

export async function getStaticPaths() {
  return await getSubCategoryPaths();
}

const { category, sub } = Astro.params;
const subCategory = await getSubCategoryBySlug(category || '', sub || '');

if (!subCategory) {
  return Astro.redirect('/products');
}

const variants = subCategory.variants;
const hasVariants = variants.length > 0;
const variantCols = (['name', 'size', 'shape', 'color', 'weight', 'capacity', 'material'] as const)
  .filter(k => hasVariants && variants.some(v => v[k] !== null && v[k] !== ''));
const variantLabels: Record<string, string> = {
  name: 'Model',
  size: 'Size (L × W × H)',
  shape: 'Shape',
  color: 'Colour',
  weight: 'Weight',
  capacity: 'Capacity / Load',
  material: 'Material'
};

// Specifications are kept as a fallback table for ranges that have no explicit variants.
const specificationModels = (subCategory.specifications || []).reduce((acc, spec) => {
  const existing = acc.find(s => s.model === spec.specification_name);
  if (existing) {
    existing[spec.specification_name.toLowerCase()] = spec.specification_value;
  } else {
    acc.push({ model: spec.specification_name, [spec.specification_name.toLowerCase()]: spec.specification_value });
  }
  return acc;
}, [] as Array<Record<string, string>>);

const features = subCategory.features || [];
const applications = (subCategory.applications || []).filter(a => a.name);
const gallery = subCategory.images.length > 0
  ? subCategory.images
  : subCategory.image_url
    ? [{ id: 'main', sub_category_id: subCategory.id, image_url: subCategory.image_url, alt_text: null, display_order: 0 }]
    : [];
const mainImage = resolveImageUrl(gallery[0]?.image_url ?? subCategory.image_url);

// Known CSS colours used to render colour swatches in the spec table.
const COLOR_HEX: Record<string, string> = {
  blue: '#2563eb', green: '#16a34a', red: '#dc2626', yellow: '#eab308',
  white: '#f8fafc', black: '#111827', grey: '#6b7280', gray: '#6b7280',
  orange: '#ea580c', brown: '#92400e', pink: '#ec4899', purple: '#7c3aed'
};

function colorSwatch(color: string | null): string {
  if (!color) return '';
  const key = color.trim().toLowerCase();
  const hex = COLOR_HEX[key] || null;
  return `<span class="v-color-chip"${hex ? ` style="--chip:${hex}"` : ''}>${color.trim()}</span>`;
}

const subtitle = subCategory.short_description || subCategory.description || subCategory.name;
const pageTitle = `${subCategory.name} | Vinayak Plastics`;
const pageDescription = `${(subCategory.description || subCategory.short_description || `Explore our ${subCategory.name} range.`).slice(0, 150)}`;

const productSchema = `{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "${subCategory.name}",
  "description": ${JSON.stringify(subCategory.description || subtitle)},
  "image": "${SITE_URL}${path('/images/vp-logo.png')}",
  "brand": { "@type": "Brand", "name": "Vinayak Plastics" },
  "category": "Material Handling Equipment"
}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  structuredData={productSchema}
>
  <Header currentPage="/products" />

  <main id="main">
  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href={path('/')}>Home</a> / <a href={path('/products')}>Products</a> / <a href={path(`/categories/${subCategory.category_slug}`)}>{subCategory.category_name}</a> / {subCategory.name}</p>
      <h1 class="display-800">{subCategory.name}</h1>
      <p>{subtitle}</p>
    </div>
  </section>

  <!-- ===== PRODUCT INTRO ===== -->
  <section class="section">
    <div class="container">
      <div class="pd-intro">
        <div class="pd-image reveal">
          {mainImage ? (
            <img
              src={mainImage}
              alt={`${subCategory.name} — ${subCategory.category_name}`}
              width={800}
              height={600}
              loading="lazy"
              decoding="async"
              class="pd-image__main"
            />
          ) : (
            <span class="cat-detail__placeholder">{subCategory.name}</span>
          )}
          {gallery.length > 1 && (
            <div class="pd-thumbs" role="group" aria-label="Product images">
              {gallery.map((img, i) => (
                <button type="button" class:list={['pd-thumb', i === 0 && 'is-active']} data-src={resolveImageUrl(img.image_url)} aria-label={`View image ${i + 1}`}>
                  <img src={resolveImageUrl(img.image_url)!} alt={img.alt_text || `${subCategory.name} image ${i + 1}`} width="120" height="90" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="pd-summary reveal">
          <h2>{subtitle}</h2>
          <p>{subCategory.description}</p>
          {features.length > 0 && (
            <ul class="pd-features">
              {features.map(feature => (
                <li>{feature}</li>
              ))}
            </ul>
          )}
          {
            subCategory.product_code && (
              <p style="font-family:var(--font-mono);font-size:0.8rem;color:var(--steel);">
                Series code: <strong>{subCategory.product_code}</strong>
              </p>
            )
          }
          <a href={path('/contact')} class="btn btn-primary">Request Pricing &amp; Specs</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SPECS TABLE ===== -->
  {(hasVariants || specificationModels.length > 0) && (
  <section class="section-warm">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="display-700">{hasVariants ? 'Sizes & Specifications' : 'Standard Specifications'}</h2>
        <p>Common {subCategory.name.toLowerCase()} dimensions produced by our unit. Custom sizes available on request.</p>
      </div>
      <div class="specs-table-wrap reveal">
        {hasVariants ? (
          <table class="specs-table">
            <thead>
              <tr>
                {variantCols.map(k => (
                  <th>{variantLabels[k]}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {variants.map(v => (
                <tr>
                  {variantCols.map(k => (
                    <td>{k === 'color' ? <span set:html={colorSwatch(v.color)} /> : (v[k] || '—')}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <table class="specs-table">
            <thead>
              <tr>
                <th>Model</th>
                <th>External Size (L × W × H) mm</th>
                <th>Weight</th>
                <th>Load Capacity</th>
                <th>Material</th>
              </tr>
            </thead>
            <tbody>
              {specificationModels.map(spec => (
                <tr>
                  <td>{spec.model}</td>
                  <td>{spec.size}</td>
                  <td>{spec.weight}</td>
                  <td>{spec.capacity}</td>
                  <td>{spec.material}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
      <div class="reveal" style="margin-top:16px;font-size:0.85rem;color:var(--steel);text-align:center">
        <p>Note: Specifications are indicative. Final dimensions and weight may vary by batch. Contact us for detailed technical drawings.</p>
      </div>
    </div>
  </section>
  )}

  <!-- ===== APPLICATIONS ===== -->
  {applications.length > 0 && (
  <section class="section">
    <div class="container-sm">
      <div class="section-header reveal">
        <h2 class="display-700">Common Applications</h2>
      </div>
      <div class="app-grid reveal">
        {applications.map(app => (
          <div class="app-card">
            <h3>{app.name}</h3>
            <p>{app.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ===== CTA ===== -->
  <section class="cta-banner" aria-label={`Enquire about ${subCategory.name.toLowerCase()}`}>
    <div class="container reveal">
      <h2 class="display-700">Need {subCategory.name.toLowerCase()} specs or pricing?</h2>
      <p>We supply {subCategory.category_name.toLowerCase()} to businesses across India. Call or WhatsApp for a quote.</p>
      <div class="cta-buttons">
        <a href={CONTACT.phoneHref} class="btn btn-primary">Call {CONTACT.phoneDisplay}</a>
        <a href={CONTACT.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>

<style>
  .pd-image__main {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--warm-off-white);
  }

  .pd-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  .pd-thumb {
    width: 84px;
    height: 64px;
    padding: 0;
    border: 2px solid rgba(18, 42, 78, 0.1);
    border-radius: var(--radius-sm);
    background: var(--warm-off-white);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pd-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6px;
  }

  .pd-thumb:hover { transform: translateY(-2px); }
  .pd-thumb.is-active { border-color: var(--orange); }

  .v-color-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .v-color-chip::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--chip, #ccc);
    border: 1px solid rgba(18, 42, 78, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
</style>

<script is:inline>
(function () {
  var main = document.querySelector('.pd-image__main');
  if (!main) return;
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('.pd-thumb'));
  thumbs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var src = btn.getAttribute('data-src');
      if (src) main.setAttribute('src', src);
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      btn.classList.add('is-active');
    });
  });
})();
</script>