---
import { Image } from 'astro:assets';
import vpLogo from '../assets/images/vp-logo.webp';
import { path } from '../lib/site';
import { CONTACT } from '../lib/contact';
import { getCatalogueData, variantSlug } from '../lib/db';

export interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

// Search is part of the catalogue experience: widen it on the Products page.
const isProducts = currentPage.startsWith('/products');

// Live search suggestions are derived from the real catalogue, so typing
// "pallet" surfaces "Plastic Pallets" on top and every suggestion navigates
// straight to an actual category / product-type page.
const catalogue = await getCatalogueData();

const POPULAR_SEARCHES = ['Plastic Crates', 'Waste Bins', 'Plastic Pallets', 'Hand Pallet Trucks', 'Standard Crates', 'Standard Trucks'];

const searchItems = [
  ...catalogue.categories.map(cat => ({
    label: cat.name,
    hint: 'Category',
    href: path(`/categories/${cat.slug}`),
    k: `${cat.name} ${cat.description || ''}`.toLowerCase(),
    group: 0
  })),
  ...catalogue.subCategories.map(sub => ({
    label: sub.name,
    hint: sub.category_name || 'Product Type',
    href: sub.category_slug ? path(`/categories/${sub.category_slug}/${sub.slug}`) : path('/products'),
    k: `${sub.name} ${sub.category_name || ''} ${sub.short_description || ''} ${sub.description || ''}`.toLowerCase(),
    group: 1
  })),
  ...catalogue.categories.flatMap(cat => cat.variants.map(v => ({
    label: v.name || v.size || '',
    hint: `${cat.name} · Size / Model`,
    href: path(`/categories/${cat.slug}/variant/${variantSlug(v.name || v.size || 'size')}`),
    k: `${v.name} ${v.size} ${v.color} ${v.material} ${cat.name}`.toLowerCase(),
    group: 2
  })))
];

// Helper function to determine if a link is active
function isActive(templatePath: string): boolean {
  if (templatePath === '/' && currentPage === '/') return true;
  if (templatePath !== '/' && currentPage.startsWith(templatePath)) return true;
  return false;
}
---

<nav class={`site-nav${isProducts ? ' nav-products' : ''}`} role="navigation" aria-label="Main navigation">
  <div class="container">
    <a href={path('/')} class="nav-logo">
      <Image src={vpLogo} alt="Vinayak Plastics" class="logo-img" width={120} height={92} loading="eager" decoding="sync" />
      <span class="logo-text">Vinayak Plastics</span>
    </a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-controls="nav-links" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-inner">
      <div class="nav-links" id="nav-links">
        <a href={path('/')} class={isActive('/') ? 'active' : ''}>Home</a>
        <a href={path('/about')} class={isActive('/about') ? 'active' : ''}>About Us</a>
        <a href={path('/products')} class={isActive('/products') ? 'active' : ''}>Products</a>
        <a href={path('/contact')} class={isActive('/contact') ? 'active' : ''}>Contact</a>
      </div>
      <div class="nav-right">
        <div class="nav-search">
          <form class="search-form" id="nav-search-form" role="search" action={path('/products')} method="get">
            <input type="search" name="q" id="nav-search-input" placeholder="Search products..." aria-label="Search products" autocomplete="off">
            <button type="submit" id="nav-search-submit" aria-label="Submit search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="M21 21l-4.35-4.35"></path>
              </svg>
            </button>
          </form>
          <div class="search-suggestions" id="search-suggestions" hidden>
            <span class="search-suggestions__label" id="search-suggestions-label">Popular Searches</span>
            <ul class="search-suggestions__list" id="search-suggestions-list"></ul>
            <p class="search-suggestions__empty" id="search-suggestions-empty" hidden>No matching products found</p>
          </div>
        </div>
        <a href={CONTACT.phoneHref} class="nav-phone" aria-label="Call us">{CONTACT.phoneDisplay}</a>
        <a href={path('/contact')} class="nav-cta">Get a Quote</a>
      </div>
    </div>
  </div>
</nav>

<script type="application/json" id="search-suggestions-data" set:html={JSON.stringify({ items: searchItems, popular: POPULAR_SEARCHES })} />

<script is:inline>
(function () {
  'use strict';

  var form = document.getElementById('nav-search-form');
  if (!form) return;

  var input = document.getElementById('nav-search-input');
  var submit = document.getElementById('nav-search-submit');
  var panel = document.getElementById('search-suggestions');
  var label = document.getElementById('search-suggestions-label');
  var list = document.getElementById('search-suggestions-list');
  var empty = document.getElementById('search-suggestions-empty');
  if (!input || !submit || !panel || !label || !list || !empty) return;

  var raw = document.getElementById('search-suggestions-data');
  var store = raw
    ? (JSON.parse(raw.textContent || '{}') || {})
    : {};
  var items = store.items || [];
  var popular = store.popular || [];

  var visibleLinks = [];
  var activeIndex = -1;

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
  var esc = escapeHtml;

  function highlight(text, q) {
    if (!q) return escapeHtml(text);
    var i = text.toLowerCase().indexOf(q.toLowerCase());
    if (i < 0) return escapeHtml(text);
    return esc(text.slice(0, i)) +
      '<mark>' + esc(text.slice(i, i + q.length)) + '</mark>' +
      esc(text.slice(i + q.length));
  }

  function score(item, lq) {
    var label = item.label.toLowerCase();
    var exact = label === lq;
    var idx = label.indexOf(lq);
    var s;
    if (exact) s = 100;
    else if (idx === 0) s = 90;
    else if (idx > 0) s = 80 - Math.min(idx, 20);
    else {
      var kw = item.k.indexOf(lq);
      if (kw < 0) return -1;
      s = 40 - Math.min(kw, 15);
    }
    return s + (item.group === 0 ? 10 : 0);
  }

  function render(arr, q) {
    list.innerHTML = '';
    visibleLinks = [];
    empty.hidden = true;
    label.textContent = q ? 'Suggestions' : 'Popular Searches';
    arr.forEach(function (item) {
      var a = document.createElement('a');
      a.className = 'search-suggestion';
      a.href = item.href;
      a.innerHTML =
        '<span class="search-suggestion__label">' + highlight(item.label, q) + '</span>' +
        '<span class="search-suggestion__hint">' + escapeHtml(item.hint) + '</span>';
      list.appendChild(a);
      visibleLinks.push(a);
    });
  }

  function buildPopular() {
    var out = [];
    popular.forEach(function (term) {
      var match = null;
      for (var i = 0; i < items.length; i++) {
        if (items[i].label.toLowerCase() === term.toLowerCase()) { match = items[i]; break; }
      }
      out.push(match || {
        label: term,
        hint: 'Search',
        href: form.action + '?q=' + encodeURIComponent(term),
        k: term.toLowerCase(),
        group: 1
      });
    });
    render(out, '');
  }

  function refresh() {
    var q = input.value.trim();
    if (!q) { buildPopular(); return; }

    var lq = q.toLowerCase();
    var matches = items.filter(function (it) { return score(it, lq) > -1; });
    matches.sort(function (a, b) {
      var d = score(b, lq) - score(a, lq);
      if (d !== 0) return d;
      if (a.group !== b.group) return a.group - b.group;
      return a.label.length - b.label.length;
    });

    if (matches.length) {
      render(matches.slice(0, 7), q);
    } else {
      list.innerHTML = '';
      visibleLinks = [];
      label.textContent = 'Suggestions';
      empty.hidden = false;
    }
  }

  function showPanel() { panel.hidden = false; }
  function hidePanel() {
    panel.hidden = true;
    setActive(-1);
  }

  function setActive(i) {
    if (activeIndex >= 0 && visibleLinks[activeIndex]) {
      visibleLinks[activeIndex].classList.remove('is-active');
    }
    activeIndex = i;
    if (i >= 0 && visibleLinks[i]) {
      visibleLinks[i].classList.add('is-active');
    }
  }

  submit.addEventListener('click', function (e) {
    if (!input.value.trim()) {
      e.preventDefault();
      buildPopular();
      showPanel();
      input.focus();
    } else {
      hidePanel();
    }
  });

  input.addEventListener('focus', function () { refresh(); showPanel(); });
  input.addEventListener('input', function () { refresh(); showPanel(); });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { hidePanel(); input.blur(); return; }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex < visibleLinks.length - 1 ? activeIndex + 1 : 0);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex > 0 ? activeIndex - 1 : visibleLinks.length - 1);
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      var target = visibleLinks[activeIndex];
      if (target) window.location.href = target.href;
    }
  });

  document.addEventListener('click', function (e) {
    if (!panel.contains(e.target) && !form.contains(e.target)) hidePanel();
  });
})();
</script>