---
import { Image } from 'astro:assets';
import vpLogo from '../assets/images/vp-logo.webp';
import { path } from '../lib/site';
import { CONTACT } from '../lib/contact';
import { getSiteSetting } from '../lib/db';

const contactSetting = await getSiteSetting('contact') as any;
const display = {
  phone: contactSetting?.phone || CONTACT.phoneDisplay,
  email: contactSetting?.email || CONTACT.email,
  address: contactSetting?.address || CONTACT.address
};
const phoneHref = `tel:+91${(contactSetting?.phone || CONTACT.phone).replace(/\D/g, '')}`;
const whatsappHref = `https://wa.me/91${(contactSetting?.whatsapp || CONTACT.phone).replace(/\D/g, '')}`;
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={path('/')} class="nav-logo">
          <Image src={vpLogo} alt="Vinayak Plastics" class="logo-img" width={120} height={92} loading="lazy" />
        </a>
        <p>Business House Engaged In Supply of All Type of Material Handling & Packaging Products — Crates, Dustbin, Ice Box, Storage Bins, Racking System, Hand Pallet Truck Etc.</p>
      </div>
      
      <div class="footer-col">
        <h3>Products</h3>
        <a href={path('/products/plastic-crates')}>Plastic Crates</a>
        <a href={path('/products/plastic-pallets')}>Plastic Pallets</a>
        <a href={path('/products/waste-bins')}>Waste Bins / Dustbins</a>
        <a href={path('/products/hand-pallet-trucks')}>Hand Pallet Trucks</a>
        <a href={path('/products')}>Ice Boxes & Racking</a>
      </div>
      
      <div class="footer-col">
        <h3>Contact</h3>
        <p>Phone: <a href={phoneHref}>{display.phone}</a></p>
        <p>WhatsApp: <a href={whatsappHref} target="_blank" rel="noopener">{display.phone}</a></p>
        <p>Email: <a href={`mailto:${display.email}`}>{display.email}</a></p>
        <p>Address: {display.address}</p>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; 2026 Vinayak Plastics. All rights reserved.</p>
    </div>
  </div>
</footer>