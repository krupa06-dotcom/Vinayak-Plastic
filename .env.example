# Supabase Configuration
# Get these from your Supabase project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# Optional: Secret key (only for admin/backend operations, never expose to client)
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# Resend — enquiry email notifications (server-side only, never expose to client)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where enquiry notifications are delivered
ENQUIRY_TO_EMAIL=your-recipient@gmail.com
# Sender address. onboarding@resend.dev works for testing ONLY (emails deliver
# solely to the email address of your Resend account). For production, add and
# verify your own domain in Resend (Domains → Add Domain), then set e.g.:
# ENQUIRY_FROM_EMAIL=Vinayak Plastics <enquiries@yourdomain.com>
ENQUIRY_FROM_EMAIL=Vinayak Plastics <onboarding@resend.dev>